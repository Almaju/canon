Acc = Int

After = Tokens

Assembly = Broken + Made

Bad = String

Body = Parsed

BodySize = Int

Broken = String

Chain = Parsed

Code = String

Codes = String

Cons = Head * Tail

Count = Int

Emitted = String

Export = Text

Exports = String

Funcs = String

Good = After * Code

Head = Token

HexByte = String

Index = Int

IsDigit = Bool

IsLetter = Bool

IsSpace = Bool

IsWord = Bool

Literal = Int

Lowered = Int

Lparen = Parsed

Made = Codes * Count * Exports * Funcs * Types

Module = String

Name = Text

Nibble = Int

Nil = Unit

Number = Text

Octet = String

Opcode = String

Operand = Parsed

Opname = Parsed

Param = Text

Parsed = Bad + Good

Pos = Int

Prev = Text

Punct = Int

Reported = Unit

Rparen = Parsed

Run = Int

Source = String

Tail = Tokens

Text = String

Token = Name
  + Number
  + Punct

Tokens = Cons + Nil

TypeEntry = String

Types = String

Utf8 = String

Widened = Int

Index * Tokens => Assembly {
    Tokens -> (
        * Cons {
            Tokens -> Parsed(Tokens -> Param) -> (
                * Bad { Bad -> Broken -> Assembly }
                * Good {
                    Good.After -> Assembly(Index -> Sum(1) -> Index) -> (
                        * Broken { Broken -> Broken -> Assembly }
                        * Made {
                            Codes(`{Good.Code -> BodySize -> Octet}00{Good.Code}0b{Made.Codes}`)
                                -> Made(
                                    Exports(`{Tokens -> Export(Prev("")) -> Length -> Octet}{Tokens -> Export(Prev("")) -> Utf8(Pos(1))}00{Index -> Octet}{Made.Exports}`)
                                    * Funcs(`{Index -> Octet}{Made.Funcs}`)
                                    * Made.Count -> Sum(1) -> Count
                                    * Types(`{Tokens -> Param -> TypeEntry}{Made.Types}`)
                                )
                                -> Assembly
                        }
                    )
                }
            )
        }
        * Nil { Codes("") -> Made(Count(0) * Exports("") * Funcs("") * Types("")) -> Assembly }
    )
}

Param * Tokens => Body {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name {
                    Name -> Eq(Param) -> (
                        * False { Bad("expected a literal") -> Parsed }
                        * True { Cons.Tail -> Chain(Code("2000") * Param) }
                    )
                }
                * Number {
                    Cons.Tail
                        -> Chain(
                            Code(`41{Acc(0) -> Literal(Pos(1) * Number -> Source) -> Emitted}`)
                            * Param
                        )
                }
                * Punct {
                    Punct -> Eq(125) -> (
                        * False { Bad("expected a literal") -> Parsed }
                        * True { Bad("declaration body is empty") -> Parsed }
                    )
                }
            )
        }
        * Nil { Bad("declaration body is empty") -> Parsed }
    )
}

Literal => BodySize {
    Literal
        -> Emitted
        -> Length
        -> Quotient(2)
        -> Sum(3)
}

Code => BodySize {
    Code
        -> Length
        -> Quotient(2)
        -> Sum(2)
}

Code * Param * Tokens => Chain {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `->` or `}`") -> Parsed }
                * Number { Bad("expected `->` or `}`") -> Parsed }
                * Punct {
                    Punct -> Eq(125) -> (
                        * False {
                            Punct -> Eq(45) -> (
                                * False { Bad("expected `->` or `}`") -> Parsed }
                                * True { Cons.Tail -> Opname(Code * Param) }
                            )
                        }
                        * True { Code -> Good(Cons.Tail -> After) -> Parsed }
                    )
                }
            )
        }
        * Nil { Bad("declaration body is unterminated") -> Parsed }
    )
}

Int => Emitted {
    Int -> Quotient(128) -> Eq(0) -> (
        * False {
            Int
                -> Remainder(128)
                -> Sum(128)
                -> Octet
                -> Joined(Int -> Quotient(128) -> Emitted)
        }
        * True {
            Int -> Ge(64) -> (
                * False { Int -> Octet }
                * True { `{Int -> Sum(128) -> Octet}00` }
            )
        }
    )
}

Prev * Tokens => Export {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Cons.Tail -> Export(Name -> Prev) }
                * Number { Cons.Tail -> Export(Prev) }
                * Punct {
                    Punct -> Eq(123) -> (
                        * False { Cons.Tail -> Export(Prev) }
                        * True { Prev }
                    )
                }
            )
        }
        * Nil { "" }
    )
}

Nibble => HexByte {
    "0123456789abcdef" -> Substring(Nibble -> Sum(1) -> From * Nibble -> Sum(1) -> To)
}

Int => IsDigit {
    Int -> Ge(48) -> (
        * False { False() }
        * True { Int -> Le(57) }
    )
}

Int => IsLetter {
    Int -> Ge(65) -> (
        * False { False() }
        * True {
            Int -> Le(90) -> (
                * False {
                    Int -> Ge(97) -> (
                        * False { False() }
                        * True { Int -> Le(122) }
                    )
                }
                * True { True() }
            )
        }
    )
}

Int => IsSpace {
    Int -> Le(32) -> (
        * False { False() }
        * True { Int -> Ge(9) }
    )
}

Int => IsWord {
    Int -> IsDigit -> (
        * False { Int -> IsLetter }
        * True { True() }
    )
}

Acc * Pos * Source => Literal {
    Pos -> Gt(Source -> Length) -> (
        * False {
            Acc
                -> Product(10)
                -> Sum(Source -> ByteAt(Pos) -> Difference(48))
                -> Acc
                -> Literal(Pos -> Sum(1) -> Pos * Source)
        }
        * True { Acc }
    )
}

Int => Lowered {
    Int -> Ge(65) -> (
        * False { Int }
        * True {
            Int -> Le(90) -> (
                * False { Int }
                * True { Int -> Sum(32) }
            )
        }
    )
}

Code * Opcode * Param * Tokens => Lparen {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `(`") -> Parsed }
                * Number { Bad("expected `(`") -> Parsed }
                * Punct {
                    Punct -> Eq(40) -> (
                        * False { Bad("expected `(`") -> Parsed }
                        * True { Cons.Tail -> Operand(Code * Opcode * Param) }
                    )
                }
            )
        }
        * Nil { Bad("expected `(`") -> Parsed }
    )
}

Made => Module {
    `0061736d0100000001{Made.Types -> Length -> Quotient(2) -> Sum(1) -> Octet}{Made.Count -> Octet}{Made.Types}03{
        Made.Funcs
            -> Length
            -> Quotient(2)
            -> Sum(1)
            -> Octet
    }{Made.Count -> Octet}{Made.Funcs}07{Made.Exports -> Length -> Quotient(2) -> Sum(1) -> Octet}{
        Made.Count -> Octet
    }{Made.Exports}0a{Made.Codes -> Length -> Quotient(2) -> Sum(1) -> Octet}{Made.Count -> Octet}{Made.Codes}`
}

Int => Octet {
    Int
        -> Quotient(16)
        -> Nibble
        -> HexByte
        -> Joined(Int -> Remainder(16) -> Nibble -> HexByte)
}

Name => Opcode {
    Name -> (
        * "Difference" { "6b" }
        * "Eq" { "46" }
        * "Ge" { "4e" }
        * "Gt" { "4a" }
        * "Le" { "4c" }
        * "Lt" { "48" }
        * "Ne" { "47" }
        * "Product" { "6c" }
        * "Quotient" { "6d" }
        * "Remainder" { "6f" }
        * "Sum" { "6a" }
        * String { "" }
    )
}

Code * Opcode * Param * Tokens => Operand {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name {
                    Name -> Eq(Param) -> (
                        * False { Bad("expected a literal operand") -> Parsed }
                        * True { Cons.Tail -> Rparen(Code(`{Code}2000{Opcode}`) * Param) }
                    )
                }
                * Number {
                    Cons.Tail
                        -> Rparen(
                            Code(`{Code}41{Acc(0) -> Literal(Pos(1) * Number -> Source) -> Emitted}{Opcode}`)
                            * Param
                        )
                }
                * Punct { Bad("expected a literal operand") -> Parsed }
            )
        }
        * Nil { Bad("expected a literal operand") -> Parsed }
    )
}

Code * Param * Tokens => Opname {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name {
                    Name -> Opcode -> Length -> Eq(0) -> (
                        * False { Cons.Tail -> Lparen(Code * Name -> Opcode * Param) }
                        * True { Bad(`{Name} is not an operation`) -> Parsed }
                    )
                }
                * Number { Bad("expected an operation after `->`") -> Parsed }
                * Punct { Bad("expected an operation after `->`") -> Parsed }
            )
        }
        * Nil { Bad("expected an operation after `->`") -> Parsed }
    )
}

Tokens => Param {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name {
                    Name -> (
                        * "Unit" { "" }
                        * String { Name }
                    )
                }
                * Number { "" }
                * Punct { "" }
            )
        }
        * Nil { "" }
    )
}

Param * Tokens => Parsed {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Cons.Tail -> Parsed(Param) }
                * Number { Cons.Tail -> Parsed(Param) }
                * Punct {
                    Punct -> Eq(123) -> (
                        * False { Cons.Tail -> Parsed(Param) }
                        * True { Cons.Tail -> Body(Param) }
                    )
                }
            )
        }
        * Nil { Bad("no declaration body") -> Parsed }
    )
}

Tokens => Reported {
    Tokens -> Assembly(Index(0)) -> (
        * Broken { Broken -> Print }
        * Made { Made -> Module -> Print }
    )
}

Code * Param * Tokens => Rparen {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `)`") -> Parsed }
                * Number { Bad("expected `)`") -> Parsed }
                * Punct {
                    Punct -> Eq(41) -> (
                        * False { Bad("expected `)`") -> Parsed }
                        * True { Cons.Tail -> Chain(Code * Param) }
                    )
                }
            )
        }
        * Nil { Bad("expected `)`") -> Parsed }
    )
}

Pos * Source => Run {
    Pos -> Gt(Source -> Length) -> (
        * False {
            Source -> ByteAt(Pos) -> IsWord -> (
                * False { Pos }
                * True { Source -> Run(Pos -> Sum(1) -> Pos) }
            )
        }
        * True { Pos }
    )
}

Text => Token {
    Text -> ByteAt(1) -> IsDigit -> (
        * False { Text -> Name -> Token }
        * True { Text -> Number -> Token }
    )
}

Pos * Source => Tokens {
    Pos -> Gt(Source -> Length) -> (
        * False {
            Source -> ByteAt(Pos) -> IsWord -> (
                * False {
                    Source -> ByteAt(Pos) -> IsSpace -> (
                        * False {
                            Source
                                -> Tokens(Source -> Widened(Pos) -> Pos)
                                -> Cons(Source -> ByteAt(Pos) -> Punct -> Token -> Head)
                                -> Tokens
                        }
                        * True { Source -> Tokens(Pos -> Sum(1) -> Pos) }
                    )
                }
                * True {
                    Source
                        -> Tokens(Source -> Run(Pos) -> Pos)
                        -> Cons(Source -> Substring(Pos -> From * Source -> Run(Pos) -> Difference(1) -> To) -> Text -> Token -> Head)
                        -> Tokens
                }
            )
        }
        * True { Nil() -> Tokens }
    )
}

Param => TypeEntry {
    Param -> Length -> Eq(0) -> (
        * False { "60017f017f" }
        * True { "6000017f" }
    )
}

Unit => Result<Program, IoError> {
    Args()
        -> At(1)?
        -> Path
        -> File?
        -> Read?
        -> Source
        -> Tokens(Pos(1))
        -> Reported
    Unit() -> Ok
}

Export * Pos => Utf8 {
    Pos -> Gt(Export -> Length) -> (
        * False {
            `{Export -> ByteAt(Pos) -> Lowered -> Octet}{Export -> Utf8(Pos -> Sum(1) -> Pos)}`
        }
        * True { "" }
    )
}

Pos * Source => Widened {
    Source -> ByteAt(Pos -> Sum(1)) -> Eq(62) -> (
        * False { Pos -> Sum(1) }
        * True { Pos -> Sum(2) }
    )
}
