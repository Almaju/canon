Acc = Int

Arrow = Unit

Bad = String

Body = Parsed

BodySize = Int

BraceClose = Unit

BraceOpen = Unit

Cons = Head * Tail

Emitted = String

Good = Literal

Head = Token

HexByte = String

IsDigit = Bool

IsLetter = Bool

IsWord = Bool

Literal = Int

Module = String

Name = Text

Nibble = Int

Nil = Unit

Number = Text

Octet = String

Parsed = Bad + Good

Pos = Int

Reported = Unit

Run = Int

Source = String

Tail = Tokens

Text = String

Token = Arrow
  + BraceClose
  + BraceOpen
  + Name
  + Number

Tokens = Cons + Nil

Tokens => Body {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Arrow { Bad("expected a literal after `{`") -> Parsed }
                * BraceClose { Bad("declaration body is empty") -> Parsed }
                * BraceOpen { Bad("expected a literal after `{`") -> Parsed }
                * Name { Bad("expected a literal after `{`") -> Parsed }
                * Number { Acc(0) -> Literal(Pos(1) * Number -> Source) -> Good -> Parsed }
            )
        }
        * Nil { Bad("declaration body is empty") -> Parsed }
    )
}

Literal => BodySize {
    Literal
        -> Emitted
        -> Length
        -> Quotient(2)
        -> Sum(3)
}

Int => Emitted {
    Int -> Quotient(128) -> Eq(0) -> (
        * False {
            Int
                -> Remainder(128)
                -> Sum(128)
                -> Octet
                -> Joined(Int -> Quotient(128) -> Emitted)
        }
        * True {
            Int -> Ge(64) -> (
                * False { Int -> Octet }
                * True { `{Int -> Sum(128) -> Octet}00` }
            )
        }
    )
}

Nibble => HexByte {
    "0123456789abcdef" -> Substring(Nibble -> Sum(1) -> From * Nibble -> Sum(1) -> To)
}

Int => IsDigit {
    Int -> Ge(48) -> (
        * False { False() }
        * True { Int -> Le(57) }
    )
}

Int => IsLetter {
    Int -> Ge(65) -> (
        * False { False() }
        * True {
            Int -> Le(90) -> (
                * False {
                    Int -> Ge(97) -> (
                        * False { False() }
                        * True { Int -> Le(122) }
                    )
                }
                * True { True() }
            )
        }
    )
}

Int => IsWord {
    Int -> IsDigit -> (
        * False { Int -> IsLetter }
        * True { True() }
    )
}

Acc * Pos * Source => Literal {
    Pos -> Gt(Source -> Length) -> (
        * False {
            Acc
                -> Product(10)
                -> Sum(Source -> ByteAt(Pos) -> Difference(48))
                -> Acc
                -> Literal(Pos -> Sum(1) -> Pos * Source)
        }
        * True { Acc }
    )
}

Literal => Module {
    `0061736d010000000105016000017f03020100070a0106616e7377657200000a{
        Literal
            -> BodySize
            -> Sum(2)
            -> Octet
    }01{Literal -> BodySize -> Octet}0041{Literal -> Emitted}0b`
}

Int => Octet {
    Int
        -> Quotient(16)
        -> Nibble
        -> HexByte
        -> Joined(Int -> Remainder(16) -> Nibble -> HexByte)
}

Tokens => Parsed {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Arrow { Cons.Tail -> Parsed }
                * BraceClose { Cons.Tail -> Parsed }
                * BraceOpen { Cons.Tail -> Body }
                * Name { Cons.Tail -> Parsed }
                * Number { Cons.Tail -> Parsed }
            )
        }
        * Nil { Bad("no declaration body") -> Parsed }
    )
}

Parsed => Reported {
    Parsed -> (
        * Bad { Bad -> Print }
        * Good { Good -> Module -> Print }
    )
}

Pos * Source => Run {
    Pos -> Gt(Source -> Length) -> (
        * False {
            Source -> ByteAt(Pos) -> IsWord -> (
                * False { Pos }
                * True { Source -> Run(Pos -> Sum(1) -> Pos) }
            )
        }
        * True { Pos }
    )
}

Text => Token {
    Text -> ByteAt(1) -> IsDigit -> (
        * False { Text -> Name -> Token }
        * True { Text -> Number -> Token }
    )
}

Pos * Source => Tokens {
    Pos -> Gt(Source -> Length) -> (
        * False {
            Source -> ByteAt(Pos) -> IsWord -> (
                * False {
                    Source -> ByteAt(Pos) -> Eq(61) -> (
                        * False {
                            Source -> ByteAt(Pos) -> Eq(123) -> (
                                * False {
                                    Source -> ByteAt(Pos) -> Eq(125) -> (
                                        * False { Source -> Tokens(Pos -> Sum(1) -> Pos) }
                                        * True {
                                            Source
                                                -> Tokens(Pos -> Sum(1) -> Pos)
                                                -> Cons(BraceClose() -> Token -> Head)
                                                -> Tokens
                                        }
                                    )
                                }
                                * True {
                                    Source
                                        -> Tokens(Pos -> Sum(1) -> Pos)
                                        -> Cons(BraceOpen() -> Token -> Head)
                                        -> Tokens
                                }
                            )
                        }
                        * True {
                            Source
                                -> Tokens(Pos -> Sum(2) -> Pos)
                                -> Cons(Arrow() -> Token -> Head)
                                -> Tokens
                        }
                    )
                }
                * True {
                    Source
                        -> Tokens(Source -> Run(Pos) -> Pos)
                        -> Cons(Source -> Substring(Pos -> From * Source -> Run(Pos) -> Difference(1) -> To) -> Text -> Token -> Head)
                        -> Tokens
                }
            )
        }
        * True { Nil() -> Tokens }
    )
}

Unit => Result<Program, IoError> {
    Args()
        -> At(1)?
        -> Path
        -> File?
        -> Read?
        -> Source
        -> Tokens(Pos(1))
        -> Parsed
        -> Reported
    Unit() -> Ok
}
