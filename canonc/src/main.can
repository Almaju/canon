Acc = Int

Bad = String

Body = Parsed

BodySize = Int

Chain = Parsed

Code = String

Cons = Head * Tail

Emitted = String

Good = Code

Head = Token

HexByte = String

IsDigit = Bool

IsLetter = Bool

IsSpace = Bool

IsWord = Bool

Literal = Int

Lparen = Parsed

Module = String

Name = Text

Nibble = Int

Nil = Unit

Number = Text

Octet = String

Opcode = String

Operand = Parsed

Opname = Parsed

Parsed = Bad + Good

Pos = Int

Punct = Int

Reported = Unit

Rparen = Parsed

Run = Int

Source = String

Tail = Tokens

Text = String

Token = Name
  + Number
  + Punct

Tokens = Cons + Nil

Widened = Int

Tokens => Body {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected a literal") -> Parsed }
                * Number {
                    Code(`41{Acc(0) -> Literal(Pos(1) * Number -> Source) -> Emitted}`)
                        -> Chain(Cons.Tail)
                }
                * Punct {
                    Punct -> Eq(125) -> (
                        * False { Bad("expected a literal") -> Parsed }
                        * True { Bad("declaration body is empty") -> Parsed }
                    )
                }
            )
        }
        * Nil { Bad("declaration body is empty") -> Parsed }
    )
}

Literal => BodySize {
    Literal
        -> Emitted
        -> Length
        -> Quotient(2)
        -> Sum(3)
}

Code => BodySize {
    Code
        -> Length
        -> Quotient(2)
        -> Sum(2)
}

Code * Tokens => Chain {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `->` or `}`") -> Parsed }
                * Number { Bad("expected `->` or `}`") -> Parsed }
                * Punct {
                    Punct -> Eq(125) -> (
                        * False {
                            Punct -> Eq(45) -> (
                                * False { Bad("expected `->` or `}`") -> Parsed }
                                * True { Code -> Opname(Cons.Tail) }
                            )
                        }
                        * True { Code -> Good -> Parsed }
                    )
                }
            )
        }
        * Nil { Bad("declaration body is unterminated") -> Parsed }
    )
}

Int => Emitted {
    Int -> Quotient(128) -> Eq(0) -> (
        * False {
            Int
                -> Remainder(128)
                -> Sum(128)
                -> Octet
                -> Joined(Int -> Quotient(128) -> Emitted)
        }
        * True {
            Int -> Ge(64) -> (
                * False { Int -> Octet }
                * True { `{Int -> Sum(128) -> Octet}00` }
            )
        }
    )
}

Nibble => HexByte {
    "0123456789abcdef" -> Substring(Nibble -> Sum(1) -> From * Nibble -> Sum(1) -> To)
}

Int => IsDigit {
    Int -> Ge(48) -> (
        * False { False() }
        * True { Int -> Le(57) }
    )
}

Int => IsLetter {
    Int -> Ge(65) -> (
        * False { False() }
        * True {
            Int -> Le(90) -> (
                * False {
                    Int -> Ge(97) -> (
                        * False { False() }
                        * True { Int -> Le(122) }
                    )
                }
                * True { True() }
            )
        }
    )
}

Int => IsSpace {
    Int -> Le(32) -> (
        * False { False() }
        * True { Int -> Ge(9) }
    )
}

Int => IsWord {
    Int -> IsDigit -> (
        * False { Int -> IsLetter }
        * True { True() }
    )
}

Acc * Pos * Source => Literal {
    Pos -> Gt(Source -> Length) -> (
        * False {
            Acc
                -> Product(10)
                -> Sum(Source -> ByteAt(Pos) -> Difference(48))
                -> Acc
                -> Literal(Pos -> Sum(1) -> Pos * Source)
        }
        * True { Acc }
    )
}

Code * Opcode * Tokens => Lparen {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `(`") -> Parsed }
                * Number { Bad("expected `(`") -> Parsed }
                * Punct {
                    Punct -> Eq(40) -> (
                        * False { Bad("expected `(`") -> Parsed }
                        * True { Code -> Operand(Opcode * Cons.Tail) }
                    )
                }
            )
        }
        * Nil { Bad("expected `(`") -> Parsed }
    )
}

Code => Module {
    `0061736d010000000105016000017f03020100070a0106616e7377657200000a{
        Code
            -> BodySize
            -> Sum(2)
            -> Octet
    }01{Code -> BodySize -> Octet}00{Code}0b`
}

Int => Octet {
    Int
        -> Quotient(16)
        -> Nibble
        -> HexByte
        -> Joined(Int -> Remainder(16) -> Nibble -> HexByte)
}

Name => Opcode {
    Name -> (
        * "Difference" { "6b" }
        * "Product" { "6c" }
        * "Sum" { "6a" }
        * String { "" }
    )
}

Code * Opcode * Tokens => Operand {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected a literal operand") -> Parsed }
                * Number {
                    Code(`{Code}41{Acc(0) -> Literal(Pos(1) * Number -> Source) -> Emitted}{Opcode}`)
                        -> Rparen(Cons.Tail)
                }
                * Punct { Bad("expected a literal operand") -> Parsed }
            )
        }
        * Nil { Bad("expected a literal operand") -> Parsed }
    )
}

Code * Tokens => Opname {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name {
                    Name -> Opcode -> Length -> Eq(0) -> (
                        * False { Code -> Lparen(Name -> Opcode * Cons.Tail) }
                        * True { Bad(`{Name} is not an operation`) -> Parsed }
                    )
                }
                * Number { Bad("expected an operation after `->`") -> Parsed }
                * Punct { Bad("expected an operation after `->`") -> Parsed }
            )
        }
        * Nil { Bad("expected an operation after `->`") -> Parsed }
    )
}

Tokens => Parsed {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Cons.Tail -> Parsed }
                * Number { Cons.Tail -> Parsed }
                * Punct {
                    Punct -> Eq(123) -> (
                        * False { Cons.Tail -> Parsed }
                        * True { Cons.Tail -> Body }
                    )
                }
            )
        }
        * Nil { Bad("no declaration body") -> Parsed }
    )
}

Parsed => Reported {
    Parsed -> (
        * Bad { Bad -> Print }
        * Good { Good -> Module -> Print }
    )
}

Code * Tokens => Rparen {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `)`") -> Parsed }
                * Number { Bad("expected `)`") -> Parsed }
                * Punct {
                    Punct -> Eq(41) -> (
                        * False { Bad("expected `)`") -> Parsed }
                        * True { Code -> Chain(Cons.Tail) }
                    )
                }
            )
        }
        * Nil { Bad("expected `)`") -> Parsed }
    )
}

Pos * Source => Run {
    Pos -> Gt(Source -> Length) -> (
        * False {
            Source -> ByteAt(Pos) -> IsWord -> (
                * False { Pos }
                * True { Source -> Run(Pos -> Sum(1) -> Pos) }
            )
        }
        * True { Pos }
    )
}

Text => Token {
    Text -> ByteAt(1) -> IsDigit -> (
        * False { Text -> Name -> Token }
        * True { Text -> Number -> Token }
    )
}

Pos * Source => Tokens {
    Pos -> Gt(Source -> Length) -> (
        * False {
            Source -> ByteAt(Pos) -> IsWord -> (
                * False {
                    Source -> ByteAt(Pos) -> IsSpace -> (
                        * False {
                            Source
                                -> Tokens(Source -> Widened(Pos) -> Pos)
                                -> Cons(Source -> ByteAt(Pos) -> Punct -> Token -> Head)
                                -> Tokens
                        }
                        * True { Source -> Tokens(Pos -> Sum(1) -> Pos) }
                    )
                }
                * True {
                    Source
                        -> Tokens(Source -> Run(Pos) -> Pos)
                        -> Cons(Source -> Substring(Pos -> From * Source -> Run(Pos) -> Difference(1) -> To) -> Text -> Token -> Head)
                        -> Tokens
                }
            )
        }
        * True { Nil() -> Tokens }
    )
}

Pos * Source => Widened {
    Source -> ByteAt(Pos -> Sum(1)) -> Eq(62) -> (
        * False { Pos -> Sum(1) }
        * True { Pos -> Sum(2) }
    )
}

Unit => Result<Program, IoError> {
    Args()
        -> At(1)?
        -> Path
        -> File?
        -> Read?
        -> Source
        -> Tokens(Pos(1))
        -> Parsed
        -> Reported
    Unit() -> Ok
}
