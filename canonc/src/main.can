Acc = Int

After = Tokens

Assembly = Broken + Made

Bad = String

Body = Parsed

BodySize = Int

Broken = String

Chain = Parsed

Closer = Parsed

Code = String

Codes = String

Cons = Head * Tail

Count = Int

Depth = Int

Dispatch = Parsed

Emitted = String

Export = Text

Exports = String

Falsebrace = Parsed

Falsecode = String

Falsemark = Parsed

Funcs = String

Good = After * Code

Head = Token

HexByte = String

Index = Int

IsDigit = Bool

IsLetter = Bool

IsSpace = Bool

IsWord = Bool

Literal = Int

Lowered = Int

Lparen = Parsed

Made = Codes * Count * Exports * Funcs * Types

Marked = Int

Module = String

Name = Text

Namecons = Namehead * Nametail

Namehead = Text

Namenil = Unit

Names = Namecons + Namenil

Nametail = Names

Nibble = Int

Nil = Unit

Number = Text

Octet = String

Opcode = String

Operand = Parsed

Opname = Parsed

Param = Text

Parsed = Bad + Good

Pos = Int

Prev = Text

Punct = Int

Reported = Unit

Rparen = Parsed

Run = Int

Seen = Int

Skipped = Tokens

Slot = Int

Slug = Text

Source = String

Tail = Tokens

Text = String

Token = Name
  + Number
  + Punct

Tokens = Cons + Nil

Truebrace = Parsed

Truecode = String

Truemark = Parsed

Truestar = Parsed

TypeEntry = String

Types = String

Utf8 = String

Wanted = Text

Widened = Int

Index * Names * Tokens => Assembly {
    Tokens -> (
        * Cons {
            Tokens -> Parsed(Names * Tokens -> Param(Prev(""))) -> (
                * Bad { Bad -> Broken -> Assembly }
                * Good {
                    Good.After -> Assembly(Index -> Sum(1) -> Index * Names) -> (
                        * Broken { Broken -> Assembly }
                        * Made {
                            Codes(`{Good.Code -> BodySize -> Octet}00{Good.Code}0b{Made.Codes}`)
                                -> Made(
                                    Exports(`{Tokens -> Export(Prev("")) -> Length -> Octet}{Tokens -> Export(Prev("")) -> Utf8(Pos(1))}00{Index -> Octet}{Made.Exports}`)
                                    * Funcs(`{Index -> Octet}{Made.Funcs}`)
                                    * Made.Count -> Sum(1) -> Count
                                    * Types(`{Tokens -> Param(Prev("")) -> TypeEntry}{Made.Types}`)
                                )
                                -> Assembly
                        }
                    )
                }
            )
        }
        * Nil { Codes("") -> Made(Count(0) * Exports("") * Funcs("") * Types("")) -> Assembly }
    )
}

Names * Param * Tokens => Body {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name {
                    Name -> Eq(Param) -> (
                        * False { Bad("expected a literal") -> Parsed }
                        * True { Cons.Tail -> Chain(Code("2000") * Names * Param) }
                    )
                }
                * Number {
                    Cons.Tail
                        -> Chain(
                            Code(`41{Acc(0) -> Literal(Pos(1) * Number -> Source) -> Emitted}`)
                            * Names
                            * Param
                        )
                }
                * Punct {
                    Punct -> Eq(125) -> (
                        * False { Bad("expected a literal") -> Parsed }
                        * True { Bad("declaration body is empty") -> Parsed }
                    )
                }
            )
        }
        * Nil { Bad("declaration body is empty") -> Parsed }
    )
}

Literal => BodySize {
    Literal
        -> Emitted
        -> Length
        -> Quotient(2)
        -> Sum(3)
}

Code => BodySize {
    Code
        -> Length
        -> Quotient(2)
        -> Sum(2)
}

Code * Names * Param * Tokens => Chain {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `->` or `}`") -> Parsed }
                * Number { Bad("expected `->` or `}`") -> Parsed }
                * Punct {
                    Punct -> Eq(125) -> (
                        * False {
                            Punct -> Eq(45) -> (
                                * False { Bad("expected `->` or `}`") -> Parsed }
                                * True { Cons.Tail -> Opname(Code * Names * Param) }
                            )
                        }
                        * True { Code -> Good(Cons.Tail -> After) -> Parsed }
                    )
                }
            )
        }
        * Nil { Bad("declaration body is unterminated") -> Parsed }
    )
}

Code * Falsecode * Names * Param * Tokens * Truecode => Closer {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `)`") -> Parsed }
                * Number { Bad("expected `)`") -> Parsed }
                * Punct {
                    Punct -> Eq(41) -> (
                        * False { Bad("expected `)`") -> Parsed }
                        * True {
                            Cons.Tail
                                -> Chain(
                                    Code(`{Code}047f{Truecode}05{Falsecode}0b`)
                                    * Names
                                    * Param
                                )
                        }
                    )
                }
            )
        }
        * Nil { Bad("expected `)`") -> Parsed }
    )
}

Code * Names * Param * Tokens => Dispatch {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `*`") -> Parsed }
                * Number { Bad("expected `*`") -> Parsed }
                * Punct {
                    Punct -> Eq(42) -> (
                        * False { Bad("expected `*`") -> Parsed }
                        * True { Cons.Tail -> Falsemark(Code * Names * Param) }
                    )
                }
            )
        }
        * Nil { Bad("expected `*`") -> Parsed }
    )
}

Int => Emitted {
    Int -> Quotient(128) -> Eq(0) -> (
        * False {
            Int
                -> Remainder(128)
                -> Sum(128)
                -> Octet
                -> Joined(Int -> Quotient(128) -> Emitted)
        }
        * True {
            Int -> Ge(64) -> (
                * False { Int -> Octet }
                * True { `{Int -> Sum(128) -> Octet}00` }
            )
        }
    )
}

Prev * Tokens => Export {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Cons.Tail -> Export(Name -> Prev) }
                * Number { Cons.Tail -> Export(Prev) }
                * Punct {
                    Punct -> Eq(123) -> (
                        * False { Cons.Tail -> Export(Prev) }
                        * True { Prev }
                    )
                }
            )
        }
        * Nil { "" }
    )
}

Code * Names * Param * Tokens => Falsebrace {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `{`") -> Parsed }
                * Number { Bad("expected `{`") -> Parsed }
                * Punct {
                    Punct -> Eq(123) -> (
                        * False { Bad("expected `{`") -> Parsed }
                        * True {
                            Cons.Tail -> Body(Names * Param) -> (
                                * Bad { Bad -> Parsed }
                                * Good {
                                    Good.After
                                        -> Truestar(Code * Good.Code -> Falsecode * Names * Param)
                                }
                            )
                        }
                    )
                }
            )
        }
        * Nil { Bad("expected `{`") -> Parsed }
    )
}

Code * Names * Param * Tokens => Falsemark {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name {
                    Name -> Eq("False") -> (
                        * False { Bad("expected `False`") -> Parsed }
                        * True { Cons.Tail -> Falsebrace(Code * Names * Param) }
                    )
                }
                * Number { Bad("expected `False`") -> Parsed }
                * Punct { Bad("expected `False`") -> Parsed }
            )
        }
        * Nil { Bad("expected `False`") -> Parsed }
    )
}

Nibble => HexByte {
    "0123456789abcdef" -> Substring(Nibble -> Sum(1) -> From * Nibble -> Sum(1) -> To)
}

Int => IsDigit {
    Int -> Ge(48) -> (
        * False { False() }
        * True { Int -> Le(57) }
    )
}

Int => IsLetter {
    Int -> Ge(65) -> (
        * False { False() }
        * True {
            Int -> Le(90) -> (
                * False {
                    Int -> Ge(97) -> (
                        * False { False() }
                        * True { Int -> Le(122) }
                    )
                }
                * True { True() }
            )
        }
    )
}

Int => IsSpace {
    Int -> Le(32) -> (
        * False { False() }
        * True { Int -> Ge(9) }
    )
}

Int => IsWord {
    Int -> IsDigit -> (
        * False { Int -> IsLetter }
        * True { True() }
    )
}

Acc * Pos * Source => Literal {
    Pos -> Gt(Source -> Length) -> (
        * False {
            Acc
                -> Product(10)
                -> Sum(Source -> ByteAt(Pos) -> Difference(48))
                -> Acc
                -> Literal(Pos -> Sum(1) -> Pos * Source)
        }
        * True { Acc }
    )
}

Int => Lowered {
    Int -> Ge(65) -> (
        * False { Int }
        * True {
            Int -> Le(90) -> (
                * False { Int }
                * True { Int -> Sum(32) }
            )
        }
    )
}

Code * Names * Opcode * Param * Tokens => Lparen {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `(`") -> Parsed }
                * Number { Bad("expected `(`") -> Parsed }
                * Punct {
                    Punct -> Eq(40) -> (
                        * False { Bad("expected `(`") -> Parsed }
                        * True { Cons.Tail -> Operand(Code * Names * Opcode * Param) }
                    )
                }
            )
        }
        * Nil { Bad("expected `(`") -> Parsed }
    )
}

Pos * Source => Marked {
    Source -> ByteAt(Pos) -> Eq(61) -> (
        * False { Source -> ByteAt(Pos) }
        * True {
            Source -> ByteAt(Pos -> Sum(1)) -> Eq(62) -> (
                * False { Source -> ByteAt(Pos) }
                * True { 62 }
            )
        }
    )
}

Made => Module {
    `0061736d0100000001{Made.Types -> Length -> Quotient(2) -> Sum(1) -> Octet}{Made.Count -> Octet}{Made.Types}03{
        Made.Funcs
            -> Length
            -> Quotient(2)
            -> Sum(1)
            -> Octet
    }{Made.Count -> Octet}{Made.Funcs}07{Made.Exports -> Length -> Quotient(2) -> Sum(1) -> Octet}{
        Made.Count -> Octet
    }{Made.Exports}0a{Made.Codes -> Length -> Quotient(2) -> Sum(1) -> Octet}{Made.Count -> Octet}{Made.Codes}`
}

Tokens => Names {
    Tokens -> (
        * Cons {
            Tokens
                -> Skipped(Depth(0))
                -> Names
                -> Namecons(Tokens -> Slug -> Namehead)
                -> Names
        }
        * Nil { Namenil() -> Names }
    )
}

Int => Octet {
    Int
        -> Quotient(16)
        -> Nibble
        -> HexByte
        -> Joined(Int -> Remainder(16) -> Nibble -> HexByte)
}

Name => Opcode {
    Name -> (
        * "Difference" { "6b" }
        * "Eq" { "46" }
        * "Ge" { "4e" }
        * "Gt" { "4a" }
        * "Le" { "4c" }
        * "Lt" { "48" }
        * "Ne" { "47" }
        * "Product" { "6c" }
        * "Quotient" { "6d" }
        * "Remainder" { "6f" }
        * "Sum" { "6a" }
        * String { "" }
    )
}

Code * Names * Opcode * Param * Tokens => Operand {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name {
                    Name -> Eq(Param) -> (
                        * False { Bad("expected a literal operand") -> Parsed }
                        * True { Cons.Tail -> Rparen(Code(`{Code}2000{Opcode}`) * Names * Param) }
                    )
                }
                * Number {
                    Cons.Tail
                        -> Rparen(
                            Code(`{Code}41{Acc(0) -> Literal(Pos(1) * Number -> Source) -> Emitted}{Opcode}`)
                            * Names
                            * Param
                        )
                }
                * Punct { Bad("expected a literal operand") -> Parsed }
            )
        }
        * Nil { Bad("expected a literal operand") -> Parsed }
    )
}

Code * Names * Param * Tokens => Opname {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name {
                    Name -> Opcode -> Length -> Eq(0) -> (
                        * False { Cons.Tail -> Lparen(Code * Names * Name -> Opcode * Param) }
                        * True {
                            Names -> Slot(Seen(0) * Name -> Wanted) -> Lt(0) -> (
                                * False {
                                    Cons.Tail
                                        -> Chain(
                                            Code(`{Code}10{Names -> Slot(Seen(0) * Name -> Wanted) -> Emitted}`)
                                            * Names
                                            * Param
                                        )
                                }
                                * True {
                                    Bad(`{Name} is not a declaration or an operation`) -> Parsed
                                }
                            )
                        }
                    )
                }
                * Number { Bad("expected an operation after `->`") -> Parsed }
                * Punct {
                    Punct -> Eq(40) -> (
                        * False { Bad("expected an operation after `->`") -> Parsed }
                        * True { Cons.Tail -> Dispatch(Code * Names * Param) }
                    )
                }
            )
        }
        * Nil { Bad("expected an operation after `->`") -> Parsed }
    )
}

Prev * Tokens => Param {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Cons.Tail -> Param(Name -> Prev) }
                * Number { Cons.Tail -> Param(Prev) }
                * Punct {
                    Punct -> Eq(62) -> (
                        * False { Cons.Tail -> Param(Prev) }
                        * True {
                            Prev -> (
                                * "Unit" { "" }
                                * String { Prev }
                            )
                        }
                    )
                }
            )
        }
        * Nil { "" }
    )
}

Names * Param * Tokens => Parsed {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Cons.Tail -> Parsed(Names * Param) }
                * Number { Cons.Tail -> Parsed(Names * Param) }
                * Punct {
                    Punct -> Eq(123) -> (
                        * False { Cons.Tail -> Parsed(Names * Param) }
                        * True { Cons.Tail -> Body(Names * Param) }
                    )
                }
            )
        }
        * Nil { Bad("no declaration body") -> Parsed }
    )
}

Tokens => Reported {
    Tokens -> Assembly(Index(0) * Tokens -> Names) -> (
        * Broken { Broken -> Print }
        * Made { Made -> Module -> Print }
    )
}

Code * Names * Param * Tokens => Rparen {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `)`") -> Parsed }
                * Number { Bad("expected `)`") -> Parsed }
                * Punct {
                    Punct -> Eq(41) -> (
                        * False { Bad("expected `)`") -> Parsed }
                        * True { Cons.Tail -> Chain(Code * Names * Param) }
                    )
                }
            )
        }
        * Nil { Bad("expected `)`") -> Parsed }
    )
}

Pos * Source => Run {
    Pos -> Gt(Source -> Length) -> (
        * False {
            Source -> ByteAt(Pos) -> IsWord -> (
                * False { Pos }
                * True { Source -> Run(Pos -> Sum(1) -> Pos) }
            )
        }
        * True { Pos }
    )
}

Depth * Tokens => Skipped {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Cons.Tail -> Skipped(Depth) }
                * Number { Cons.Tail -> Skipped(Depth) }
                * Punct {
                    Punct -> Eq(123) -> (
                        * False {
                            Punct -> Eq(125) -> (
                                * False { Cons.Tail -> Skipped(Depth) }
                                * True {
                                    Depth -> Le(1) -> (
                                        * False {
                                            Cons.Tail -> Skipped(Depth -> Difference(1) -> Depth)
                                        }
                                        * True { Cons.Tail }
                                    )
                                }
                            )
                        }
                        * True { Cons.Tail -> Skipped(Depth -> Sum(1) -> Depth) }
                    )
                }
            )
        }
        * Nil { Nil() -> Tokens }
    )
}

Names * Seen * Wanted => Slot {
    Names -> (
        * Namecons {
            Namecons.Namehead -> Eq(Wanted) -> (
                * False { Namecons.Nametail -> Slot(Seen -> Sum(1) -> Seen * Wanted) }
                * True { Seen }
            )
        }
        * Namenil { 0 -> Difference(1) }
    )
}

Tokens => Slug {
    Tokens -> Param(Prev("")) -> Length -> Eq(0) -> (
        * False { Tokens -> Export(Prev("")) }
        * True { "" }
    )
}

Text => Token {
    Text -> ByteAt(1) -> IsDigit -> (
        * False { Text -> Name -> Token }
        * True { Text -> Number -> Token }
    )
}

Pos * Source => Tokens {
    Pos -> Gt(Source -> Length) -> (
        * False {
            Source -> ByteAt(Pos) -> IsWord -> (
                * False {
                    Source -> ByteAt(Pos) -> IsSpace -> (
                        * False {
                            Source
                                -> Tokens(Source -> Widened(Pos) -> Pos)
                                -> Cons(Source -> Marked(Pos) -> Punct -> Token -> Head)
                                -> Tokens
                        }
                        * True { Source -> Tokens(Pos -> Sum(1) -> Pos) }
                    )
                }
                * True {
                    Source
                        -> Tokens(Source -> Run(Pos) -> Pos)
                        -> Cons(Source -> Substring(Pos -> From * Source -> Run(Pos) -> Difference(1) -> To) -> Text -> Token -> Head)
                        -> Tokens
                }
            )
        }
        * True { Nil() -> Tokens }
    )
}

Code * Falsecode * Names * Param * Tokens => Truebrace {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `{`") -> Parsed }
                * Number { Bad("expected `{`") -> Parsed }
                * Punct {
                    Punct -> Eq(123) -> (
                        * False { Bad("expected `{`") -> Parsed }
                        * True {
                            Cons.Tail -> Body(Names * Param) -> (
                                * Bad { Bad -> Parsed }
                                * Good {
                                    Good.After
                                        -> Closer(
                                            Code
                                            * Falsecode
                                            * Names
                                            * Param
                                            * Good.Code -> Truecode
                                        )
                                }
                            )
                        }
                    )
                }
            )
        }
        * Nil { Bad("expected `{`") -> Parsed }
    )
}

Code * Falsecode * Names * Param * Tokens => Truemark {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name {
                    Name -> Eq("True") -> (
                        * False { Bad("expected `True`") -> Parsed }
                        * True { Cons.Tail -> Truebrace(Code * Falsecode * Names * Param) }
                    )
                }
                * Number { Bad("expected `True`") -> Parsed }
                * Punct { Bad("expected `True`") -> Parsed }
            )
        }
        * Nil { Bad("expected `True`") -> Parsed }
    )
}

Code * Falsecode * Names * Param * Tokens => Truestar {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `*`") -> Parsed }
                * Number { Bad("expected `*`") -> Parsed }
                * Punct {
                    Punct -> Eq(42) -> (
                        * False { Bad("expected `*`") -> Parsed }
                        * True { Cons.Tail -> Truemark(Code * Falsecode * Names * Param) }
                    )
                }
            )
        }
        * Nil { Bad("expected `*`") -> Parsed }
    )
}

Param => TypeEntry {
    Param -> Length -> Eq(0) -> (
        * False { "60017f017f" }
        * True { "6000017f" }
    )
}

Unit => Result<Program, IoError> {
    Args()
        -> At(1)?
        -> Path
        -> File?
        -> Read?
        -> Source
        -> Tokens(Pos(1))
        -> Reported
    Unit() -> Ok
}

Export * Pos => Utf8 {
    Pos -> Gt(Export -> Length) -> (
        * False {
            `{Export -> ByteAt(Pos) -> Lowered -> Octet}{Export -> Utf8(Pos -> Sum(1) -> Pos)}`
        }
        * True { "" }
    )
}

Pos * Source => Widened {
    Source -> ByteAt(Pos -> Sum(1)) -> Eq(62) -> (
        * False { Pos -> Sum(1) }
        * True { Pos -> Sum(2) }
    )
}
