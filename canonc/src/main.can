Code * Ender * Falsecode * Params * Stringy * Tables * Tokens => Truebrace {
    Tokens -> (
        * Cons {
            Cons.Head -> (
                * Name { Bad("expected `{`") -> Parsed }
                * Number { Bad("expected `{`") -> Parsed }
                * Punct {
                    Punct -> Eq(123) -> (
                        * False { Bad("expected `{`") -> Parsed }
                        * True {
                            Cons.Tail -> Body(Ender(125) * Params * Tables) -> (
                                * Bad { Bad -> Parsed }
                                * Good {
                                    Good.After
                                        -> Closer(
                                            Code
                                            * Ender
                                            * Falsecode
                                            * Stringy
                                            * Tables
                                            * Params
                                            * Good.Code -> Truecode
                                        )
                                }
                            )
                        }
                    )
                }
                * Quoted { Bad("expected `{`") -> Parsed }
            )
        }
        * Nil { Bad("expected `{`") -> Parsed }
    )
}

Code * Ender * Falsecode * Params * Stringy * Tables * Tokens => Truemark {
