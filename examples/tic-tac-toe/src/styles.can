Unit => Styles {
    Html("<style>body{margin:0;background:#0d1117;color:#c9d1d9;font:16px/1.5 -apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif}.game{max-width:360px;margin:0 auto;padding:32px 24px;text-align:center}h1{font-size:26px}.verdict{min-height:1.5em;color:#8b949e}.grid{display:grid;grid-template-columns:repeat(3,96px);gap:8px;justify-content:center;margin:16px 0}.cell{height:96px;font-size:40px;background:#161b22;color:#f0f6fc;border:1px solid #30363d;border-radius:8px;cursor:pointer}.cell:hover{border-color:#8b949e}.cell.taken{cursor:default}.reset{background:#238636;color:#fff;border:0;border-radius:6px;padding:8px 18px;font-size:14px;cursor:pointer}</style>")
