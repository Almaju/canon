Replied = Board

Board => Replied {
    Board -> Over -> (
        * False {
            Board
                -> Seed
                -> Next
                -> Below(Board -> Free -> Bound)
                -> Sum(1)
                -> Nth
                -> Index(Board * Cursor(1))
                -> Marked(Board * Piece("O"))
        }
        * True { Board }
    )
}
