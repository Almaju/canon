AddedTodo = Todos

Cleared = Todos

FirstLine = String

ParsedNum = Int

RemovedAt = Todos

RenderedItems = Html

RestLines = String

Todos = String

ToggledAt = Todos

Title * Todos => AddedTodo {
    Todos(`{Todos.String}0|{Title.String}\n`)
}

Todos => Cleared {
    Todos.String -> Length -> Eq(0) -> (
        * False {
            Todos.String -> ByteAt(1) -> Eq(49) -> (
                * False {
                    Todos(`{Todos.String -> FirstLine}\n{
                        Todos.String
                            -> RestLines
                            -> Todos
                            -> Cleared
                            -> String
                    }`)
                }
                * True { Todos.String -> RestLines -> Todos -> Cleared }
            )
        }
        * True { Todos }
    )
}

String => FirstLine {
    String -> Length -> Eq(0) -> (
        * False {
            String -> ByteAt(1) -> Eq(10) -> (
                * False {
                    String
                        -> Substring(From(1) * To(1))
                        -> Joined(String -> Substring(From(2) * String -> Length -> To) -> FirstLine)
                }
                * True { "" }
            )
        }
        * True { "" }
    )
}

String => ParsedNum {
    String -> Length -> Eq(0) -> (
        * False {
            String
                -> Substring(From(1) * String -> Length -> Difference(1) -> To)
                -> ParsedNum
                -> Product(10)
                -> Sum(String -> ByteAt(String -> Length) -> Difference(48))
        }
        * True { 0 }
    )
}

Int * Todos => RemovedAt {
    Todos.String -> Length -> Eq(0) -> (
        * False {
            Int -> Eq(1) -> (
                * False {
                    Todos(`{Todos.String -> FirstLine}\n{
                        Int
                            -> Difference(1)
                            -> RemovedAt(Todos.String -> RestLines -> Todos)
                            -> String
                    }`)
                }
                * True { Todos.String -> RestLines -> Todos }
            )
        }
        * True { Todos }
    )
}

Int * Todos => RenderedItems {
    Todos.String -> Length -> Eq(0) -> (
        * False {
            Int
                -> RenderedItem(Todos.String -> FirstLine -> Line)
                -> String
                -> Joined(Int -> Sum(1) -> RenderedItems(Todos.String -> RestLines -> Todos) -> String)
                -> Html
        }
        * True { Html("") }
    )
}

String => RestLines {
    String -> Length -> Eq(0) -> (
        * False {
            String -> ByteAt(1) -> Eq(10) -> (
                * False { String -> Substring(From(2) * String -> Length -> To) -> RestLines }
                * True { String -> Substring(From(2) * String -> Length -> To) }
            )
        }
        * True { "" }
    )
}

Int * Todos => ToggledAt {
    Todos.String -> Length -> Eq(0) -> (
        * False {
            Int -> Eq(1) -> (
                * False {
                    Todos(`{Todos.String -> FirstLine}\n{
                        Int
                            -> Difference(1)
                            -> ToggledAt(Todos.String -> RestLines -> Todos)
                            -> String
                    }`)
                }
                * True {
                    Todos(`{Todos.String -> FirstLine -> Line -> Flipped -> String}\n{
                        Todos.String -> RestLines
                    }`)
                }
            )
        }
        * True { Todos }
    )
}
