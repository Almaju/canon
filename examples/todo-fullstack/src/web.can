AddForm = ElAttr

ClearButton = Button

Init = Todos

LoadButton = ElAttr

Prefix = String

Update = Todos

Unit => AddForm {
    Attr("data-msg-form=\"Add:\"")
        -> ElAttr(
            Attr("placeholder=\"What needs doing?\"") -> ElAttr("" * Tag("input"))
            * Tag("form")
        )
}

Unit => ClearButton {
    Msg("Clear") -> Button("Clear completed")
}

Todos => Html {
    Div(`<h1>Canon Todos</h1>{AddForm() -> String}{1 -> RenderedItems(Todos) -> Ul}{
        ClearButton() -> String
    }{LoadButton() -> String}`)
}

Unit => Init {
    List(False() -> Todo(Title("build the canon frontend")) * False() -> Todo(Title("check the canon backend")))
        -> Todos
}

Unit => LoadButton {
    Attr("data-fetch=\"/todos\" data-fetch-msg=\"Load:\"")
        -> ElAttr("Load todos from the server" * Tag("button"))
}

Todos * String => Update {
    String -> Substring(From(1) * To(4)) -> Prefix -> (
        * "Add:" {
            String
                -> Substring(From(5) * String -> Length -> To)
                -> Title
                -> AddedTodo(Todos)
        }
        * "Clea" { Todos -> Cleared }
        * "Dele" {
            String -> Substring(From(8) * String -> Length -> To) -> Int -> (
                * Err<MalformedInt> { Todos }
                * Ok<Int> { Int -> RemovedAt(Todos) }
            )
        }
        * "Load" { String -> Substring(From(6) * String -> Length -> To) -> Wire -> Todos }
        * "Togg" {
            String -> Substring(From(8) * String -> Length -> To) -> Int -> (
                * Err<MalformedInt> { Todos }
                * Ok<Int> { Int -> ToggledAt(Todos) }
            )
        }
        * Prefix { Todos }
    )
}
