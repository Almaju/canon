Notes = Json

Routed = Response

Shown = Response

Unit => Notes {
    [{"id":1,"title":"ship canon v1"},{"id":2,"title":"write the docs"}]
}

RoutePath => Routed {
    RoutePath -> Segments -> First -> (
        * None { Location("/notes") -> Redirect }
        * Some<String> {
            String -> (
                * "notes" {
                    RoutePath -> Segments -> At(2) -> (
                        * None { Notes() -> JsonResponse }
                        * Some<String> {
                            String -> Int -> (
                                * Err<MalformedInt> { NotFound() }
                                * Ok<Int> { Int -> Shown }
                            )
                        }
                    )
                }
                * String { NotFound() }
            )
        }
    )
}

Int => Shown {
    Int -> (
        * 1 { {"id":1,"title":"ship canon v1"} -> JsonResponse }
        * 2 { {"id":2,"title":"write the docs"} -> JsonResponse }
        * Int { NotFound() }
    )
}

Request => Response {
    Request.path() -> (
        * None { NotFound() }
        * Some<String> { String -> RoutePath -> Routed }
    )
}
