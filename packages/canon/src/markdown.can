Int * String => Inline {
    Int -> Gt(String -> Length) -> (
        * False {
            String -> ByteAt(Int) -> Eq(96) -> (
                * False {
                    String -> ByteAt(Int) -> Eq(42) -> (
                        * False {
                            String -> ByteAt(Int) -> Eq(91) -> (
                                * False {
                                    String
                                        -> Substring(Int -> From * Int -> To)
                                        -> Escaped
                                        -> Joined(Int -> Sum(1) -> Inline(String))
                                }
                                * True {
                                    Int
                                        -> Sum(1)
                                        -> BracketClose(String)
                                        -> Sum(1)
                                        -> Gt(String -> Length) -> (
                                        * False {
                                            String
                                                -> ByteAt(Int -> Sum(1) -> BracketClose(String) -> Sum(1))
                                                -> Eq(40) -> (
                                                * False { `[{Int -> Sum(1) -> Inline(String)}` }
                                                * True {
                                                    `<a href="{
                                                        String
                                                            -> Substring(Int -> Sum(1) -> BracketClose(String) -> Sum(2) -> From * Int -> Sum(1) -> BracketClose(String) -> Sum(1) -> ParenClose(String) -> Difference(1) -> To)
                                                            -> Escaped
                                                    }">{
                                                        1
                                                            -> Inline(String -> Substring(Int -> Sum(1) -> From * Int -> Sum(1) -> BracketClose(String) -> Difference(1) -> To))
                                                    }</a>{
                                                        Int
                                                            -> Sum(1)
                                                            -> BracketClose(String)
                                                            -> Sum(1)
                                                            -> ParenClose(String)
                                                            -> Sum(1)
                                                            -> Inline(String)
                                                    }`
                                                }
                                            )
                                        }
                                        * True { `[{Int -> Sum(1) -> Inline(String)}` }
                                    )
                                }
                            )
                        }
                        * True {
                            Int -> Sum(1) -> Gt(String -> Length) -> (
                                * False {
                                    String -> ByteAt(Int -> Sum(1)) -> Eq(42) -> (
                                        * False {
                                            Int
                                                -> Sum(1)
                                                -> StarOneClose(String)
                                                -> Gt(String -> Length) -> (
                                                * False {
                                                    `<em>{
                                                        1
                                                            -> Inline(String -> Substring(Int -> Sum(1) -> From * Int -> Sum(1) -> StarOneClose(String) -> Difference(1) -> To))
                                                    }</em>{
                                                        Int
                                                            -> Sum(1)
                                                            -> StarOneClose(String)
                                                            -> Sum(1)
                                                            -> Inline(String)
                                                    }`
                                                }
                                                * True { `*{Int -> Sum(1) -> Inline(String)}` }
                                            )
                                        }
                                        * True {
                                            `<strong>{
                                                1
                                                    -> Inline(String -> Substring(Int -> Sum(2) -> From * Int -> Sum(2) -> StarClose(String) -> Difference(1) -> To))
                                            }</strong>{
                                                Int
                                                    -> Sum(2)
                                                    -> StarClose(String)
                                                    -> Sum(2)
                                                    -> Inline(String)
                                            }`
                                        }
                                    )
                                }
                                * True { "*" }
                            )
                        }
                    )
                }
                * True {
                    `<code>{
                        String
                            -> Substring(Int -> Sum(1) -> From * Int -> Sum(1) -> TickClose(String) -> Difference(1) -> To)
                            -> Escaped
                    }</code>{Int -> Sum(1) -> TickClose(String) -> Sum(1) -> Inline(String)}`
                }
            )
        }
        * True { "" }
    )
}

