Limb = Int

LimbBase = Int

LimbBorrow = Int

LimbCarry = Int

LimbDigit = Int

LimbFactor = Int

LimbIndex = Int

LimbSteps = Int

Limbs = List<Int>

LimbsAdd = LimbCarry * LimbIndex * LimbsPlus

LimbsBelow = Bool

LimbsBelowFrom = LimbsBelow

LimbsDivided = LimbDigit * LimbsLeftover

LimbsLeftover = Limbs

LimbsMinus = Limbs

LimbsMultiply = LimbCarry * LimbFactor * LimbIndex

LimbsPlus = Limbs

LimbsReduce = LimbBorrow * LimbIndex * LimbsMinus

LimbsShift = Int

LimbsStepped = LimbsDivided

LimbsTimes = Int

LimbIndex * Limbs => Limb {
    Limbs -> At(LimbIndex) -> (
        * None { 0 }
        * Some<Int> { Int }
    )
}

Unit => LimbBase {
    1073741824
}

Int => Limbs {
    Int -> Eq(0) -> (
        * False {
            List(Int -> Remainder(LimbBase()))
                -> Joined(Int -> Quotient(LimbBase()) -> Limbs)
                -> Limbs
        }
        * True { List() }
    )
}

Limbs * LimbsAdd => Limbs {
    Limbs -> At(LimbsAdd.LimbIndex) -> (
        * None {
            LimbsAdd.LimbsPlus -> At(LimbsAdd.LimbIndex) -> (
                * None { LimbsAdd.LimbCarry -> Limbs }
                * Some<Int> {
                    List(Int -> Sum(LimbsAdd.LimbCarry) -> Remainder(LimbBase()))
                        -> Joined(Limbs -> LimbsAdd(Int -> Sum(LimbsAdd.LimbCarry) -> Quotient(LimbBase()) -> LimbCarry * LimbsAdd.LimbIndex -> Sum(1) -> LimbIndex * LimbsAdd.LimbsPlus))
                }
            )
        }
        * Some<Int> {
            List(Int -> Sum(LimbsAdd.LimbIndex -> Limb(LimbsAdd.LimbsPlus)) -> Sum(LimbsAdd.LimbCarry) -> Remainder(LimbBase()))
                -> Joined(Limbs -> LimbsAdd(Int -> Sum(LimbsAdd.LimbIndex -> Limb(LimbsAdd.LimbsPlus)) -> Sum(LimbsAdd.LimbCarry) -> Quotient(LimbBase()) -> LimbCarry * LimbsAdd.LimbIndex -> Sum(1) -> LimbIndex * LimbsAdd.LimbsPlus))
        }
    )
}

Limbs * LimbsMinus => Limbs {
    Limbs -> LimbsReduce(LimbBorrow(0) * LimbIndex(1) * LimbsMinus)
}

Limbs * LimbsMultiply => Limbs {
    Limbs -> At(LimbsMultiply.LimbIndex) -> (
        * None { LimbsMultiply.LimbCarry -> Limbs }
        * Some<Int> {
            List(Int -> Product(LimbsMultiply.LimbFactor) -> Sum(LimbsMultiply.LimbCarry) -> Remainder(LimbBase()))
                -> Joined(Limbs -> LimbsMultiply(Int -> Product(LimbsMultiply.LimbFactor) -> Sum(LimbsMultiply.LimbCarry) -> Quotient(LimbBase()) -> LimbCarry * LimbsMultiply.LimbFactor * LimbsMultiply.LimbIndex -> Sum(1) -> LimbIndex))
        }
    )
}

Limbs * LimbsPlus => Limbs {
    Limbs -> LimbsAdd(LimbCarry(0) * LimbIndex(1) * LimbsPlus)
}

Limbs * LimbsReduce => Limbs {
    Limbs -> At(LimbsReduce.LimbIndex) -> (
        * None { List() }
        * Some<Int> {
            Int
                -> Difference(LimbsReduce.LimbIndex -> Limb(LimbsReduce.LimbsMinus))
                -> Difference(LimbsReduce.LimbBorrow)
                -> Lt(0) -> (
                * False {
                    List(Int -> Difference(LimbsReduce.LimbIndex -> Limb(LimbsReduce.LimbsMinus)) -> Difference(LimbsReduce.LimbBorrow))
                        -> Joined(Limbs -> LimbsReduce(LimbBorrow(0) * LimbsReduce.LimbIndex -> Sum(1) -> LimbIndex * LimbsReduce.LimbsMinus))
                }
                * True {
                    List(Int -> Difference(LimbsReduce.LimbIndex -> Limb(LimbsReduce.LimbsMinus)) -> Difference(LimbsReduce.LimbBorrow) -> Sum(LimbBase()))
                        -> Joined(Limbs -> LimbsReduce(LimbBorrow(1) * LimbsReduce.LimbIndex -> Sum(1) -> LimbIndex * LimbsReduce.LimbsMinus))
                }
            )
        }
    )
}

Limbs * LimbsShift => Limbs {
    LimbsShift -> Eq(0) -> (
        * False {
            LimbsShift -> Lt(30) -> (
                * False {
                    List(0)
                        -> Joined(Limbs)
                        -> Limbs
                        -> LimbsShift(LimbsShift -> Difference(30))
                }
                * True { Limbs -> LimbsTimes(2) -> LimbsShift(LimbsShift -> Difference(1)) }
            )
        }
        * True { Limbs }
    )
}

Limbs * LimbsTimes => Limbs {
    Limbs -> LimbsMultiply(LimbCarry(0) * LimbsTimes -> LimbFactor * LimbIndex(1))
}

Limbs^2 => LimbsBelow {
    LimbIndex(1) -> LimbsBelowFrom(False() -> LimbsBelow * Limbs.1 * Limbs.2)
}

LimbIndex * LimbsBelow * Limbs^2 => LimbsBelowFrom {
    Limbs.1 -> At(LimbIndex) -> (
        * None {
            Limbs.2 -> At(LimbIndex) -> (
                * None { LimbsBelow }
                * Some<Int> {
                    Int -> Eq(0) -> (
                        * False { True() }
                        * True {
                            LimbIndex
                                -> Sum(1)
                                -> LimbIndex
                                -> LimbsBelowFrom(LimbsBelow * Limbs.1 * Limbs.2)
                        }
                    )
                }
            )
        }
        * Some<Int> {
            Int -> Eq(LimbIndex -> Limb(Limbs.2)) -> (
                * False {
                    LimbIndex
                        -> Sum(1)
                        -> LimbIndex
                        -> LimbsBelowFrom(
                            Int -> Lt(LimbIndex -> Limb(Limbs.2)) -> LimbsBelow
                            * Limbs.1
                            * Limbs.2
                        )
                }
                * True {
                    LimbIndex
                        -> Sum(1)
                        -> LimbIndex
                        -> LimbsBelowFrom(LimbsBelow * Limbs.1 * Limbs.2)
                }
            )
        }
    )
}

LimbSteps * Limbs^2 => LimbsStepped {
    Limbs.1 -> LimbsBelow(Limbs.2) -> (
        * False {
            LimbSteps
                -> Sum(1)
                -> LimbSteps
                -> LimbsStepped(Limbs.1 -> LimbsMinus(Limbs.2) * Limbs.2)
        }
        * True { LimbSteps -> LimbDigit -> LimbsDivided(Limbs.1 -> LimbsLeftover) }
    )
}
