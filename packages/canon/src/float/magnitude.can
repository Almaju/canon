DecimalAdvanced = DecimalState

DecimalCount = Int

DecimalDenominator = Limbs

DecimalDrop = Unit

DecimalEmit = DecimalDigit

DecimalEmitted = DecimalCount * DecimalText

DecimalEven = Bool

DecimalGenerate = DecimalStep

DecimalGenerated = DecimalEmitted

DecimalLift = Unit

DecimalLower = Limbs

DecimalNumerator = Limbs

DecimalPlace = Int

DecimalPlaced = String

DecimalPrepared = DecimalState

DecimalReaching = LimbsBelow

DecimalRounded = DecimalDigit

DecimalState = DecimalDenominator
  * DecimalEven
  * DecimalLower
  * DecimalNumerator
  * DecimalPlace
  * DecimalUpper

DecimalStep = DecimalState * LimbsDivided

DecimalStepped = DecimalStep

DecimalTenfold = Unit

DecimalText = String

DecimalUpper = Limbs

DecimalWithin = LimbsBelow

DecimalZeros = String

FloatExponent = Int

FloatMantissa = Int

FloatNormalized = FloatParts

FloatParts = FloatExponent * FloatMantissa

FloatUnequal = Bool

Magnitude = String

DecimalStep => DecimalAdvanced {
    DecimalStep.DecimalState.DecimalDenominator
        -> DecimalState(
            DecimalStep.DecimalState.DecimalEven
            * DecimalStep.DecimalState.DecimalLower
            * DecimalStep.DecimalState.DecimalPlace
            * DecimalStep.DecimalState.DecimalUpper
            * DecimalStep.LimbsDivided.LimbsLeftover -> DecimalNumerator
        )
}

DecimalEmitted * DecimalEmit => DecimalEmitted {
    DecimalEmitted.DecimalCount
        -> Sum(1)
        -> DecimalCount
        -> DecimalEmitted(DecimalText(`{DecimalEmitted.DecimalText}{DecimalEmit}`))
}

DecimalEmitted * DecimalGenerate => DecimalEmitted {
    DecimalGenerate.DecimalStep -> DecimalWithin -> (
        * False {
            DecimalGenerate.DecimalStep -> DecimalReaching -> (
                * False {
                    DecimalEmitted
                        -> DecimalEmit(DecimalGenerate.DecimalStep.LimbsDivided.LimbDigit -> DecimalDigit)
                        -> DecimalGenerate(DecimalGenerate.DecimalStep -> DecimalAdvanced -> DecimalTenfold -> DecimalStepped)
                }
                * True {
                    DecimalEmitted
                        -> DecimalEmit(DecimalGenerate.DecimalStep.LimbsDivided.LimbDigit -> Sum(1) -> DecimalDigit)
                }
            )
        }
        * True {
            DecimalGenerate.DecimalStep -> DecimalReaching -> (
                * False {
                    DecimalEmitted
                        -> DecimalEmit(DecimalGenerate.DecimalStep.LimbsDivided.LimbDigit -> DecimalDigit)
                }
                * True {
                    DecimalEmitted -> DecimalEmit(DecimalGenerate.DecimalStep -> DecimalRounded)
                }
            )
        }
    )
}

FloatParts => DecimalEven {
    FloatParts.FloatMantissa
        -> Remainder(2)
        -> Eq(0)
}

DecimalState => DecimalGenerated {
    DecimalCount(0)
        -> DecimalEmitted(DecimalText(""))
        -> DecimalGenerate(DecimalState -> DecimalTenfold -> DecimalStepped)
        -> DecimalGenerated
}

DecimalEmitted * DecimalPlace => DecimalPlaced {
    DecimalPlace -> Lt(1) -> (
        * False {
            DecimalPlace -> Lt(DecimalEmitted.DecimalCount) -> (
                * False {
                    `{DecimalEmitted.DecimalText}{
                        DecimalPlace
                            -> Difference(DecimalEmitted.DecimalCount)
                            -> DecimalZeros
                    }`
                }
                * True {
                    `{DecimalEmitted.DecimalText -> Substring(From(1) * DecimalPlace -> To)}.{
                        DecimalEmitted.DecimalText
                            -> Substring(
                                DecimalPlace -> Sum(1) -> From
                                * DecimalEmitted.DecimalCount -> To
                            )
                    }`
                }
            )
        }
        * True { `0.{0 -> Difference(DecimalPlace) -> DecimalZeros}{DecimalEmitted.DecimalText}` }
    )
}

DecimalState => DecimalPlaced {
    DecimalState
        -> DecimalGenerated
        -> DecimalPlaced(DecimalState.DecimalPlace)
}

FloatParts => DecimalPrepared {
    FloatParts.FloatExponent -> Lt(0) -> (
        * False {
            FloatParts -> FloatUnequal -> (
                * False {
                    DecimalPlace(0)
                        -> DecimalState(
                            FloatParts -> DecimalEven
                            * Limbs(1) -> LimbsShift(FloatParts.FloatExponent) -> DecimalLower
                            * Limbs(1) -> LimbsShift(FloatParts.FloatExponent) -> DecimalUpper
                            * FloatParts.FloatMantissa -> Limbs -> LimbsShift(FloatParts.FloatExponent -> Sum(1)) -> DecimalNumerator
                            * Limbs(2) -> DecimalDenominator
                        )
                }
                * True {
                    DecimalPlace(0)
                        -> DecimalState(
                            FloatParts -> DecimalEven
                            * Limbs(1) -> LimbsShift(FloatParts.FloatExponent) -> DecimalLower
                            * Limbs(1) -> LimbsShift(FloatParts.FloatExponent -> Sum(1)) -> DecimalUpper
                            * FloatParts.FloatMantissa -> Limbs -> LimbsShift(FloatParts.FloatExponent -> Sum(2)) -> DecimalNumerator
                            * Limbs(4) -> DecimalDenominator
                        )
                }
            )
        }
        * True {
            FloatParts -> FloatUnequal -> (
                * False {
                    Limbs(1)
                        -> LimbsShift(1 -> Difference(FloatParts.FloatExponent))
                        -> DecimalDenominator
                        -> DecimalState(
                            DecimalPlace(0)
                            * FloatParts -> DecimalEven
                            * FloatParts.FloatMantissa -> Limbs -> LimbsShift(1) -> DecimalNumerator
                            * Limbs(1) -> DecimalLower
                            * Limbs(1) -> DecimalUpper
                        )
                }
                * True {
                    Limbs(1)
                        -> LimbsShift(2 -> Difference(FloatParts.FloatExponent))
                        -> DecimalDenominator
                        -> DecimalState(
                            DecimalPlace(0)
                            * FloatParts -> DecimalEven
                            * FloatParts.FloatMantissa -> Limbs -> LimbsShift(2) -> DecimalNumerator
                            * Limbs(1) -> DecimalLower
                            * Limbs(2) -> DecimalUpper
                        )
                }
            )
        }
    )
}

DecimalState => DecimalReaching {
    DecimalState.DecimalEven -> (
        * False {
            DecimalState.DecimalDenominator
                -> LimbsBelow(DecimalState.DecimalNumerator -> LimbsPlus(DecimalState.DecimalUpper))
        }
        * True {
            DecimalState.DecimalNumerator
                -> LimbsPlus(DecimalState.DecimalUpper)
                -> LimbsBelow(DecimalState.DecimalDenominator) -> (
                * False { True() }
                * True { False() }
            )
        }
    )
}

DecimalStep => DecimalReaching {
    DecimalStep.DecimalState.DecimalEven -> (
        * False {
            DecimalStep.DecimalState.DecimalDenominator
                -> LimbsBelow(DecimalStep.LimbsDivided.LimbsLeftover -> LimbsPlus(DecimalStep.DecimalState.DecimalUpper))
        }
        * True {
            DecimalStep.LimbsDivided.LimbsLeftover
                -> LimbsPlus(DecimalStep.DecimalState.DecimalUpper)
                -> LimbsBelow(DecimalStep.DecimalState.DecimalDenominator) -> (
                * False { True() }
                * True { False() }
            )
        }
    )
}

DecimalStep => DecimalRounded {
    DecimalStep.LimbsDivided.LimbsLeftover
        -> LimbsShift(1)
        -> LimbsBelow(DecimalStep.DecimalState.DecimalDenominator) -> (
        * False { DecimalStep.LimbsDivided.LimbDigit -> Sum(1) -> DecimalDigit }
        * True { DecimalStep.LimbsDivided.LimbDigit -> DecimalDigit }
    )
}

DecimalState * DecimalDrop => DecimalState {
    DecimalState -> DecimalTenfold -> DecimalReaching -> (
        * False { DecimalState -> DecimalTenfold -> DecimalDrop }
        * True { DecimalState }
    )
}

DecimalState * DecimalLift => DecimalState {
    DecimalState -> DecimalReaching -> (
        * False { DecimalState }
        * True {
            DecimalState.DecimalDenominator
                -> LimbsTimes(10)
                -> DecimalDenominator
                -> DecimalState(
                    DecimalState.DecimalEven
                    * DecimalState.DecimalLower
                    * DecimalState.DecimalNumerator
                    * DecimalState.DecimalPlace -> Sum(1) -> DecimalPlace
                    * DecimalState.DecimalUpper
                )
                -> DecimalLift
        }
    )
}

DecimalState * DecimalTenfold => DecimalState {
    DecimalState.DecimalDenominator
        -> DecimalState(
            DecimalState.DecimalEven
            * DecimalState.DecimalLower -> LimbsTimes(10) -> DecimalLower
            * DecimalState.DecimalNumerator -> LimbsTimes(10) -> DecimalNumerator
            * DecimalState.DecimalPlace -> Difference(1) -> DecimalPlace
            * DecimalState.DecimalUpper -> LimbsTimes(10) -> DecimalUpper
        )
}

DecimalState => DecimalStepped {
    DecimalState
        -> DecimalStep(LimbSteps(0) -> LimbsStepped(DecimalState.DecimalNumerator * DecimalState.DecimalDenominator))
}

DecimalStep => DecimalWithin {
    DecimalStep.DecimalState.DecimalEven -> (
        * False {
            DecimalStep.LimbsDivided.LimbsLeftover
                -> LimbsBelow(DecimalStep.DecimalState.DecimalLower)
        }
        * True {
            DecimalStep.DecimalState.DecimalLower
                -> LimbsBelow(DecimalStep.LimbsDivided.LimbsLeftover) -> (
                * False { True() }
                * True { False() }
            )
        }
    )
}

Int => DecimalZeros {
    Int -> Eq(0) -> (
        * False { `0{Int -> Difference(1) -> DecimalZeros}` }
        * True { "" }
    )
}

FloatExponent * Float => FloatNormalized {
    Float -> Lt(4503599627370496.0) -> (
        * False {
            Float -> Lt(9007199254740992.0) -> (
                * False {
                    FloatExponent
                        -> Sum(1)
                        -> FloatExponent
                        -> FloatNormalized(Float -> Quotient(2.0))
                }
                * True { Float -> Int -> FloatMantissa -> FloatParts(FloatExponent) }
            )
        }
        * True {
            FloatExponent -> Sum(1074) -> Eq(0) -> (
                * False {
                    FloatExponent
                        -> Difference(1)
                        -> FloatExponent
                        -> FloatNormalized(Float -> Product(2.0))
                }
                * True { Float -> Int -> FloatMantissa -> FloatParts(FloatExponent) }
            )
        }
    )
}

Float => FloatNormalized {
    FloatExponent(0) -> FloatNormalized(Float)
}

FloatParts => FloatUnequal {
    FloatParts.FloatMantissa -> Eq(4503599627370496) -> (
        * False { False() }
        * True { 0 -> Lt(FloatParts.FloatExponent -> Sum(1074)) }
    )
}

Float => Magnitude {
    Float
        -> FloatNormalized
        -> DecimalPrepared
        -> DecimalLift
        -> DecimalDrop
        -> DecimalPlaced
}
