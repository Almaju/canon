DecimalAdvanced = DecimalState

DecimalAppended = DecimalEmitted

DecimalCount = Int

DecimalDenominator = Limbs

DecimalEmitted = DecimalCount * DecimalText

DecimalEven = Bool

DecimalGenerated = DecimalAppended

DecimalLower = Limbs

DecimalLowered = DecimalState

DecimalNumerator = Limbs

DecimalPlace = Int

DecimalPlaced = String

DecimalPrepared = DecimalState

DecimalRaised = DecimalState

DecimalReaching = LimbsBelow

DecimalRounded = DecimalDigit

DecimalState = DecimalDenominator
  * DecimalEven
  * DecimalLower
  * DecimalNumerator
  * DecimalPlace
  * DecimalUpper

DecimalStep = DecimalState * LimbsDivided

DecimalStepped = DecimalStep

DecimalTenfold = DecimalState

DecimalText = String

DecimalUpper = Limbs

DecimalWithin = LimbsBelow

DecimalZeros = String

FloatExponent = Int

FloatMantissa = Int

FloatNormalized = FloatParts

FloatParts = FloatExponent * FloatMantissa

FloatUnequal = Bool

Magnitude = String

DecimalStep => DecimalAdvanced {
    DecimalStep.DecimalState.DecimalDenominator
        -> DecimalState(
            DecimalStep.DecimalState.DecimalEven
            * DecimalStep.DecimalState.DecimalLower
            * DecimalStep.DecimalState.DecimalPlace
            * DecimalStep.DecimalState.DecimalUpper
            * DecimalStep.LimbsDivided.LimbsLeftover -> DecimalNumerator
        )
}

DecimalDigit * DecimalEmitted => DecimalAppended {
    DecimalEmitted.DecimalCount
        -> Sum(1)
        -> DecimalCount
        -> DecimalEmitted(DecimalText(`{DecimalEmitted.DecimalText}{DecimalDigit}`))
}

FloatParts => DecimalEven {
    FloatParts.FloatMantissa
        -> Remainder(2)
        -> Eq(0)
}

DecimalEmitted * DecimalStep => DecimalGenerated {
    DecimalStep -> DecimalWithin -> (
        * False {
            DecimalStep -> DecimalReaching -> (
                * False {
                    DecimalStep.LimbsDivided.LimbDigit
                        -> DecimalDigit
                        -> DecimalAppended(DecimalEmitted)
                        -> DecimalGenerated(DecimalStep -> DecimalAdvanced -> DecimalTenfold -> DecimalStepped)
                }
                * True {
                    DecimalStep.LimbsDivided.LimbDigit
                        -> Sum(1)
                        -> DecimalDigit
                        -> DecimalAppended(DecimalEmitted)
                }
            )
        }
        * True {
            DecimalStep -> DecimalReaching -> (
                * False {
                    DecimalStep.LimbsDivided.LimbDigit
                        -> DecimalDigit
                        -> DecimalAppended(DecimalEmitted)
                }
                * True { DecimalStep -> DecimalRounded -> DecimalAppended(DecimalEmitted) }
            )
        }
    )
}

DecimalState => DecimalGenerated {
    DecimalCount(0)
        -> DecimalEmitted(DecimalText(""))
        -> DecimalGenerated(DecimalState -> DecimalTenfold -> DecimalStepped)
}

DecimalState => DecimalLowered {
    DecimalState -> DecimalTenfold -> DecimalReaching -> (
        * False { DecimalState -> DecimalTenfold -> DecimalLowered }
        * True { DecimalState }
    )
}

DecimalEmitted * DecimalPlace => DecimalPlaced {
    DecimalPlace -> Lt(1) -> (
        * False {
            DecimalPlace -> Lt(DecimalEmitted.DecimalCount) -> (
                * False {
                    `{DecimalEmitted.DecimalText}{
                        DecimalPlace
                            -> Difference(DecimalEmitted.DecimalCount)
                            -> DecimalZeros
                    }`
                }
                * True {
                    `{DecimalEmitted.DecimalText -> Substring(From(1) * DecimalPlace -> To)}.{
                        DecimalEmitted.DecimalText
                            -> Substring(
                                DecimalPlace -> Sum(1) -> From
                                * DecimalEmitted.DecimalCount -> To
                            )
                    }`
                }
            )
        }
        * True { `0.{0 -> Difference(DecimalPlace) -> DecimalZeros}{DecimalEmitted.DecimalText}` }
    )
}

DecimalState => DecimalPlaced {
    DecimalState
        -> DecimalGenerated
        -> DecimalPlaced(DecimalState.DecimalPlace)
}

FloatParts => DecimalPrepared {
    FloatParts.FloatExponent -> Lt(0) -> (
        * False {
            FloatParts -> FloatUnequal -> (
                * False {
                    DecimalPlace(0)
                        -> DecimalState(
                            FloatParts -> DecimalEven
                            * FloatParts.FloatExponent -> LimbShift -> LimbsShifted(Limbs(1)) -> DecimalLower
                            * FloatParts.FloatExponent -> LimbShift -> LimbsShifted(Limbs(1)) -> DecimalUpper
                            * FloatParts.FloatExponent -> Sum(1) -> LimbShift -> LimbsShifted(FloatParts.FloatMantissa -> Limbs) -> DecimalNumerator
                            * Limbs(2) -> DecimalDenominator
                        )
                }
                * True {
                    DecimalPlace(0)
                        -> DecimalState(
                            FloatParts -> DecimalEven
                            * FloatParts.FloatExponent -> LimbShift -> LimbsShifted(Limbs(1)) -> DecimalLower
                            * FloatParts.FloatExponent -> Sum(1) -> LimbShift -> LimbsShifted(Limbs(1)) -> DecimalUpper
                            * FloatParts.FloatExponent -> Sum(2) -> LimbShift -> LimbsShifted(FloatParts.FloatMantissa -> Limbs) -> DecimalNumerator
                            * Limbs(4) -> DecimalDenominator
                        )
                }
            )
        }
        * True {
            FloatParts -> FloatUnequal -> (
                * False {
                    1
                        -> Difference(FloatParts.FloatExponent)
                        -> LimbShift
                        -> LimbsShifted(Limbs(1))
                        -> DecimalDenominator
                        -> DecimalState(
                            DecimalPlace(0)
                            * FloatParts -> DecimalEven
                            * LimbShift(1) -> LimbsShifted(FloatParts.FloatMantissa -> Limbs) -> DecimalNumerator
                            * Limbs(1) -> DecimalLower
                            * Limbs(1) -> DecimalUpper
                        )
                }
                * True {
                    2
                        -> Difference(FloatParts.FloatExponent)
                        -> LimbShift
                        -> LimbsShifted(Limbs(1))
                        -> DecimalDenominator
                        -> DecimalState(
                            DecimalPlace(0)
                            * FloatParts -> DecimalEven
                            * LimbShift(2) -> LimbsShifted(FloatParts.FloatMantissa -> Limbs) -> DecimalNumerator
                            * Limbs(1) -> DecimalLower
                            * Limbs(2) -> DecimalUpper
                        )
                }
            )
        }
    )
}

DecimalState => DecimalRaised {
    DecimalState -> DecimalReaching -> (
        * False { DecimalState }
        * True {
            DecimalState.DecimalDenominator
                -> LimbsTimes(LimbFactor(10))
                -> DecimalDenominator
                -> DecimalState(
                    DecimalState.DecimalEven
                    * DecimalState.DecimalLower
                    * DecimalState.DecimalNumerator
                    * DecimalState.DecimalPlace -> Sum(1) -> DecimalPlace
                    * DecimalState.DecimalUpper
                )
                -> DecimalRaised
        }
    )
}

DecimalState => DecimalReaching {
    DecimalState.DecimalEven -> (
        * False {
            DecimalState.DecimalDenominator
                -> LimbsBelow(DecimalState.DecimalNumerator -> LimbsTotal(DecimalState.DecimalUpper))
        }
        * True {
            DecimalState.DecimalNumerator
                -> LimbsTotal(DecimalState.DecimalUpper)
                -> LimbsBelow(DecimalState.DecimalDenominator) -> (
                * False { True() }
                * True { False() }
            )
        }
    )
}

DecimalStep => DecimalReaching {
    DecimalStep.DecimalState.DecimalEven -> (
        * False {
            DecimalStep.DecimalState.DecimalDenominator
                -> LimbsBelow(DecimalStep.LimbsDivided.LimbsLeftover -> LimbsTotal(DecimalStep.DecimalState.DecimalUpper))
        }
        * True {
            DecimalStep.LimbsDivided.LimbsLeftover
                -> LimbsTotal(DecimalStep.DecimalState.DecimalUpper)
                -> LimbsBelow(DecimalStep.DecimalState.DecimalDenominator) -> (
                * False { True() }
                * True { False() }
            )
        }
    )
}

DecimalStep => DecimalRounded {
    DecimalStep.LimbsDivided.LimbsLeftover
        -> LimbsShifted(LimbShift(1))
        -> LimbsBelow(DecimalStep.DecimalState.DecimalDenominator) -> (
        * False { DecimalStep.LimbsDivided.LimbDigit -> Sum(1) -> DecimalDigit }
        * True { DecimalStep.LimbsDivided.LimbDigit -> DecimalDigit }
    )
}

DecimalTenfold => DecimalStepped {
    DecimalTenfold
        -> DecimalStep(LimbSteps(0) -> LimbsStepped(DecimalTenfold.DecimalState.DecimalNumerator * DecimalTenfold.DecimalState.DecimalDenominator))
}

DecimalState => DecimalTenfold {
    DecimalState.DecimalDenominator
        -> DecimalState(
            DecimalState.DecimalEven
            * DecimalState.DecimalLower -> LimbsTimes(LimbFactor(10)) -> DecimalLower
            * DecimalState.DecimalNumerator -> LimbsTimes(LimbFactor(10)) -> DecimalNumerator
            * DecimalState.DecimalPlace -> Difference(1) -> DecimalPlace
            * DecimalState.DecimalUpper -> LimbsTimes(LimbFactor(10)) -> DecimalUpper
        )
}

DecimalStep => DecimalWithin {
    DecimalStep.DecimalState.DecimalEven -> (
        * False {
            DecimalStep.LimbsDivided.LimbsLeftover
                -> LimbsBelow(DecimalStep.DecimalState.DecimalLower)
        }
        * True {
            DecimalStep.DecimalState.DecimalLower
                -> LimbsBelow(DecimalStep.LimbsDivided.LimbsLeftover) -> (
                * False { True() }
                * True { False() }
            )
        }
    )
}

Int => DecimalZeros {
    Int -> Eq(0) -> (
        * False { `0{Int -> Difference(1) -> DecimalZeros}` }
        * True { "" }
    )
}

FloatExponent * Float => FloatNormalized {
    Float -> Lt(4503599627370496.0) -> (
        * False {
            Float -> Lt(9007199254740992.0) -> (
                * False {
                    FloatExponent
                        -> Sum(1)
                        -> FloatExponent
                        -> FloatNormalized(Float -> Quotient(2.0))
                }
                * True { Float -> Int -> FloatMantissa -> FloatParts(FloatExponent) }
            )
        }
        * True {
            FloatExponent -> Sum(1074) -> Eq(0) -> (
                * False {
                    FloatExponent
                        -> Difference(1)
                        -> FloatExponent
                        -> FloatNormalized(Float -> Product(2.0))
                }
                * True { Float -> Int -> FloatMantissa -> FloatParts(FloatExponent) }
            )
        }
    )
}

Float => FloatNormalized {
    FloatExponent(0) -> FloatNormalized(Float)
}

FloatParts => FloatUnequal {
    FloatParts.FloatMantissa -> Eq(4503599627370496) -> (
        * False { False() }
        * True { 0 -> Lt(FloatParts.FloatExponent -> Sum(1074)) }
    )
}

Float => Magnitude {
    Float
        -> FloatNormalized
        -> DecimalPrepared
        -> DecimalRaised
        -> DecimalLowered
        -> DecimalPlaced
        -> Magnitude
}
