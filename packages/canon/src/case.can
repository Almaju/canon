Lowercased = String

LowercasedByte = String

LowercasedSpan = Lowercased

Uppercased = String

UppercasedByte = String

UppercasedSpan = Uppercased

String => Lowercased {
    String -> LowercasedSpan(From(1) * String -> Length -> To)
}

Int => LowercasedByte {
    Int -> Ge(65) -> (
        * False { Int -> Byte -> String }
        * True {
            Int -> Le(90) -> (
                * False { Int -> Byte -> String }
                * True { Int -> Sum(32) -> Byte -> String }
            )
        }
    )
}

From * String * To => LowercasedSpan {
    To -> Lt(From) -> (
        * False {
            From -> Eq(To) -> (
                * False {
                    From
                        -> LowercasedSpan(From -> Sum(To) -> Quotient(2) -> To * String)
                        -> Joined(From -> Sum(To) -> Quotient(2) -> Sum(1) -> From -> LowercasedSpan(String * To))
                }
                * True { String -> ByteAt(From) -> LowercasedByte }
            )
        }
        * True { "" }
    )
}

String => Uppercased {
    String -> UppercasedSpan(From(1) * String -> Length -> To)
}

Int => UppercasedByte {
    Int -> Ge(97) -> (
        * False { Int -> Byte -> String }
        * True {
            Int -> Le(122) -> (
                * False { Int -> Byte -> String }
                * True { Int -> Difference(32) -> Byte -> String }
            )
        }
    )
}

From * String * To => UppercasedSpan {
    To -> Lt(From) -> (
        * False {
            From -> Eq(To) -> (
                * False {
                    From
                        -> UppercasedSpan(From -> Sum(To) -> Quotient(2) -> To * String)
                        -> Joined(From -> Sum(To) -> Quotient(2) -> Sum(1) -> From -> UppercasedSpan(String * To))
                }
                * True { String -> ByteAt(From) -> UppercasedByte }
            )
        }
        * True { "" }
    )
}
