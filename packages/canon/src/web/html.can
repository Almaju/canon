Escaped = Html

EscapedHtmlByte = Escaped

EscapedHtmlSpan = Escaped

Html = String

String => Escaped {
    String -> EscapedHtmlSpan(From(1) * String -> Length -> To)
}

Html => Escaped {
    Html
}

Int => Escaped {
    Int
        -> String
        -> Escaped
}

Int => EscapedHtmlByte {
    Int -> (
        * 34 { Html("&quot;") }
        * 38 { Html("&amp;") }
        * 60 { Html("&lt;") }
        * 62 { Html("&gt;") }
        * Int { Int -> Byte -> String -> Html }
    )
}

From * String * To => EscapedHtmlSpan {
    To -> Lt(From) -> (
        * False {
            From -> Eq(To) -> (
                * False {
                    From
                        -> EscapedHtmlSpan(From -> Sum(To) -> Quotient(2) -> To * String)
                        -> Joined(From -> Sum(To) -> Quotient(2) -> Sum(1) -> From -> EscapedHtmlSpan(String * To))
                        -> Html
                }
                * True { String -> ByteAt(From) -> EscapedHtmlByte }
            )
        }
        * True { Html("") }
    )
}
