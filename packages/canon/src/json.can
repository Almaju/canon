        * True {
            Int -> (
                * 8 { "\\b" }
                * 9 { "\\t" }
                * 10 { "\\n" }
                * 12 { "\\f" }
                * 13 { "\\r" }
                * Int { `\\u00{Int -> Quotient(16) -> HexDigit}{Int -> Remainder(16) -> HexDigit}` }
            )
        }
    )
}

Int => EscapedMeaning {
