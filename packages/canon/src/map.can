Contains = Bool

Insert<K, V> = Key<K> * Value<V>

Key<K> = K

Keys<K> = List<Key<K>>

Length = Int

Map<K, V> = Empty + Node<K, V>

Node<K, V> = Key<K> * Rest<K, V> * Value<V>

Remove<K> = K

Rest<K, V> = Map<K, V>

Value<V> = V

Values<V> = List<Value<V>>

<K, V>(Key<K> * Map<K, V>) => Contains {
    Map -> Value(Key) -> (
        * None { False() }
        * Some<Value> { True() }
    )
}

<K, V>(Map<K, V>) => Keys<K> {
    Map -> (
        * Empty { List() }
        * Node { List(Node.Key) -> Joined(Node.Rest -> Keys) }
    )
}

<K, V>(Map<K, V>) => Length {
    Map -> (
        * Empty { 0 }
        * Node { Node.Rest -> Length -> Sum(1) }
    )
}

<K: Ord, V>(Insert<K, V> * Map<K, V>) => Map<K, V> {
    Map -> (
        * Empty { Empty() -> Node(Insert.Key * Insert.Value) }
        * Node {
            Insert.Key -> Ord(Node.Key) -> (
                * Equal { Node.Rest -> Node(Insert.Key * Insert.Value) }
                * Greater { Node.Key -> Node(Node.Rest -> Insert(Insert) * Node.Value) }
                * Less { Map -> Node(Insert.Key * Insert.Value) }
            )
        }
    )
}

<K, V>(Map<K, V> * Remove<K>) => Map<K, V> {
    Map -> (
        * Empty { Empty() }
        * Node {
            Node.Key -> Eq(Remove) -> (
                * False { Node.Key -> Node(Node.Rest -> Remove(Remove) * Node.Value) }
                * True { Node.Rest }
            )
        }
    )
}

<K, V>(Unit) => Map<K, V> {
    Empty()
}

<K, V>(Key<K> * Map<K, V>) => Option<Value<V>> {
    Map -> (
        * Empty { None() }
        * Node {
            Node.Key -> Eq(Key) -> (
                * False { Node.Rest -> Value(Key) }
                * True { Node.Value -> Some }
            )
        }
    )
}

<K, V>(Map<K, V>) => Values<V> {
    Map -> (
        * Empty { List() }
        * Node { List(Node.Value) -> Joined(Node.Rest -> Values) }
    )
}
