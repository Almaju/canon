Contains = Bool

Insert = Key * Value

Key = String

Keys = List<Key>

Length = Int

Map = Empty + Node

Node = Key * Rest * Value

Remove = String

Rest = Map

Value = String

Values = List<Value>

Map * Key => Contains {
    Map -> Value(Key) -> (
        * None { False() }
        * Some<Value> { True() }
    )
}

Map => Keys {
    Map -> (
        * Empty { List() }
        * Node { List(Node.Key) -> Joined(Node.Rest -> Keys) }
    )
}

Map => Length {
    Map -> (
        * Empty { 0 }
        * Node { Node.Rest -> Length -> Sum(1) }
    )
}

Map * Insert => Map {
    Map -> (
        * Empty { Empty() -> Node(Insert.Key * Insert.Value) }
        * Node {
            Insert.Key -> Ord(Node.Key) -> (
                * Equal { Node.Rest -> Node(Insert.Key * Insert.Value) }
                * Greater { Node.Key -> Node(Node.Rest -> Insert(Insert) * Node.Value) }
                * Less { Map -> Node(Insert.Key * Insert.Value) }
            )
        }
    )
}

Map * Remove => Map {
    Map -> (
        * Empty { Empty() }
        * Node {
            Node.Key -> Eq(Remove) -> (
                * False { Node.Key -> Node(Node.Rest -> Remove(Remove) * Node.Value) }
                * True { Node.Rest }
            )
        }
    )
}

Unit => Map {
    Empty()
}

Map * Key => Option<Value> {
    Map -> (
        * Empty { None() }
        * Node {
            Node.Key -> Eq(Key) -> (
                * False { Node.Rest -> Value(Key) }
                * True { Node.Value -> Some }
            )
        }
    )
}

Map => Values {
    Map -> (
        * Empty { List() }
        * Node { List(Node.Value) -> Joined(Node.Rest -> Values) }
    )
}
