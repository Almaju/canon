DatePart = String

Now = String

TimePart = String

Civil => DatePart {
    `{Civil.Year -> Padded(Width(4))}-{Civil.Month -> Padded(Width(2))}-{
        Civil.Day -> Padded(Width(2))
    }`
}

Unit => Now {
    Unix() -> Now
}

Unix => Now {
    `{Unix -> Date -> DatePart}T{Unix -> TimePart}Z`
}

Unix => TimePart {
    `{Unix -> Hour -> Padded(Width(2))}:{Unix -> Minute -> Padded(Width(2))}:{
        Unix
            -> Second
            -> Padded(Width(2))
    }`
}
