Add<T> = T

Contains = Bool

Entry<T> = Item<T> * Remaining<T>

Item<T> = T

Items<T> = List<Item<T>>

Length = Int

Remaining<T> = Set<T>

Remove<T> = T

Set<T> = Absent + Entry<T>

<T>(Set<T> * T) => Contains {
    Set -> (
        * Absent { False() }
        * Entry {
            Entry.Item -> Eq(T) -> (
                * False { Entry.Remaining -> Contains(T) }
                * True { True() }
            )
        }
    )
}

<T>(Set<T>) => Items<T> {
    Set -> (
        * Absent { List() }
        * Entry { List(Entry.Item) -> Joined(Entry.Remaining -> Items) }
    )
}

<T>(Set<T>) => Length {
    Set -> (
        * Absent { 0 }
        * Entry { Entry.Remaining -> Length -> Sum(1) }
    )
}

<T: Ord>(Add<T> * Set<T>) => Set<T> {
    Set -> (
        * Absent { Absent() -> Entry(Add) }
        * Entry {
            Add -> Ord(Entry.Item) -> (
                * Equal { Set }
                * Greater { Entry.Item -> Entry(Entry.Remaining -> Add(Add)) }
                * Less { Set -> Entry(Add) }
            )
        }
    )
}

<T>(Remove<T> * Set<T>) => Set<T> {
    Set -> (
        * Absent { Absent() }
        * Entry {
            Entry.Item -> Eq(Remove) -> (
                * False { Entry.Item -> Entry(Entry.Remaining -> Remove(Remove)) }
                * True { Entry.Remaining }
            )
        }
    )
}

<T>(Unit) => Set<T> {
    Absent()
}
