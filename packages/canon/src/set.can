Add = String

Contains = Bool

Entry = Item * Remaining

Item = String

Length = Int

Remaining = Set

Remove = String

Set = Absent + Entry

Set * String => Contains {
    Set -> (
        * Absent { False() }
        * Entry {
            Entry.Item -> Eq(String) -> (
                * False { Entry.Remaining -> Contains(String) }
                * True { True() }
            )
        }
    )
}

Set => Length {
    Set -> (
        * Absent { 0 }
        * Entry { Entry.Remaining -> Length -> Sum(1) }
    )
}

Set => List<Item> {
    Set -> (
        * Absent { List() }
        * Entry { List(Entry.Item) -> Joined(Entry.Remaining -> List) }
    )
}

Set * Add => Set {
    Set -> (
        * Absent { Absent() -> Entry(Add) }
        * Entry {
            Add -> Ord(Entry.Item) -> (
                * Equal { Set }
                * Greater { Entry.Item -> Entry(Entry.Remaining -> Add(Add)) }
                * Less { Set -> Entry(Add) }
            )
        }
    )
}

Set * Remove => Set {
    Set -> (
        * Absent { Absent() }
        * Entry {
            Entry.Item -> Eq(Remove) -> (
                * False { Entry.Item -> Entry(Entry.Remaining -> Remove(Remove)) }
                * True { Entry.Remaining }
            )
        }
    )
}

Unit => Set {
    Absent()
}
