Ge = Bool

Gt = Bool

Le = Bool

Ne = Bool

Float^2 => Ge {
    Float.2 -> Lt(Float.1) -> (
        * False { Float.1 -> Eq(Float.2) }
        * True { True() }
    )
}

Float^2 => Gt {
    Float.2 -> Lt(Float.1)
}

Float^2 => Le {
    Float.1 -> Lt(Float.2) -> (
        * False { Float.1 -> Eq(Float.2) }
        * True { True() }
    )
}

Float^2 => Ne {
    Float.1 -> Eq(Float.2) -> (
        * False { True() }
        * True { False() }
    )
}
