DecimalDigit = String

Decimals = String

Ge = Bool

Gt = Bool

Le = Bool

Ne = Bool

Padded = String

Width = Int

Int => DecimalDigit {
    "0123456789" -> Substring(Int -> Sum(1) -> From * Int -> Sum(1) -> To)
}

Int => Decimals {
    Int -> Quotient(10) -> Eq(0) -> (
        * False {
            Int
                -> Quotient(10)
                -> Decimals
                -> Joined(0 -> Difference(Int -> Remainder(10)) -> DecimalDigit)
        }
        * True { 0 -> Difference(Int) -> DecimalDigit }
    )
}

String^2 => Ge {
    String.2 -> Lt(String.1) -> (
        * False { String.1 -> Eq(String.2) }
        * True { True() }
    )
}

String^2 => Gt {
    String.2 -> Lt(String.1)
}

String^2 => Le {
    String.1 -> Lt(String.2) -> (
        * False { String.1 -> Eq(String.2) }
        * True { True() }
    )
}

String^2 => Ne {
    String.1 -> Eq(String.2) -> (
        * False { True() }
        * True { False() }
    )
}

Int * Width => Padded {
    Int -> Quotient(10) -> Eq(0) -> (
        * False {
            Int
                -> Quotient(10)
                -> Padded(Width -> Difference(1) -> Width)
                -> Joined(Int -> Remainder(10) -> DecimalDigit)
        }
        * True {
            Width -> Lt(2) -> (
                * False { `0{Int -> Padded(Width -> Difference(1) -> Width)}` }
                * True { Int -> DecimalDigit }
            )
        }
    )
}

Bool => String {
    Bool -> (
        * False { "False" }
        * True { "True" }
    )
}

Float => String {
    Float -> Eq(Float) -> (
        * False { "NaN" }
        * True {
            Float -> Difference(Float) -> Eq(0.0) -> (
                * False {
                    Float -> Lt(0.0) -> (
                        * False { "Inf" }
                        * True { "-Inf" }
                    )
                }
                * True {
                    Float -> Eq(0.0) -> (
                        * False {
                            Float -> Lt(0.0) -> (
                                * False { Float -> Magnitude }
                                * True { `-{0.0 -> Difference(Float) -> Magnitude}` }
                            )
                        }
                        * True { "0" }
                    )
                }
            )
        }
    )
}

Int => String {
    Int -> Lt(0) -> (
        * False { 0 -> Difference(Int) -> Decimals }
        * True { `-{Int -> Decimals}` }
    )
}
