DecimalDigit = String

Decimals = String

Fraction = String

Ge = Bool

Gt = Bool

Le = Bool

Magnitude = String

Ne = Bool

OtherString = String

Padded = String

Scaled = Int

Width = Int

Int => DecimalDigit {
    "0123456789" -> Substring(Int -> Sum(1) -> From * Int -> Sum(1) -> To)
}

Int => Decimals {
    Int -> Quotient(10) -> Eq(0) -> (
        * False {
            Int
                -> Quotient(10)
                -> Decimals
                -> Joined(0 -> Difference(Int -> Remainder(10)) -> DecimalDigit)
        }
        * True { 0 -> Difference(Int) -> DecimalDigit }
    )
}

Int * Width => Fraction {
    Int -> Remainder(10) -> Eq(0) -> (
        * False { Int -> Padded(Width) }
        * True { Int -> Quotient(10) -> Fraction(Width -> Difference(1)) }
    )
}

String * OtherString => Ge {
    OtherString -> Lt(String) -> (
        * False { String -> Eq(OtherString) }
        * True { True() }
    )
}

String * OtherString => Gt {
    OtherString -> Lt(String)
}

String * OtherString => Le {
    String -> Lt(OtherString) -> (
        * False { String -> Eq(OtherString) }
        * True { True() }
    )
}

Float => Magnitude {
    Float -> Difference(Float) -> Eq(0.0) -> (
        * False { "Inf" }
        * True {
            Float -> Lt(9223372036854776000.0) -> (
                * False { "9223372036854775807" }
                * True {
                    Float -> Scaled -> Lt(1000000) -> (
                        * False { Float -> Int -> Sum(1) -> String }
                        * True {
                            Float -> Scaled -> Eq(0) -> (
                                * False {
                                    `{Float -> Int -> String}.{
                                        Float
                                            -> Scaled
                                            -> Fraction(Width(6))
                                    }`
                                }
                                * True { Float -> Int -> String }
                            )
                        }
                    )
                }
            )
        }
    )
}

String * OtherString => Ne {
    String -> Eq(OtherString) -> (
        * False { True() }
        * True { False() }
    )
}

Int * Width => Padded {
    Int -> Quotient(10) -> Eq(0) -> (
        * False {
            Int
                -> Quotient(10)
                -> Padded(Width -> Difference(1))
                -> Joined(Int -> Remainder(10) -> DecimalDigit)
        }
        * True {
            Width -> Lt(2) -> (
                * False { `0{Int -> Padded(Width -> Difference(1))}` }
                * True { Int -> DecimalDigit }
            )
        }
    )
}

Float => Scaled {
    Float
        -> Difference(Float -> Int -> Float)
        -> Product(1000000.0)
        -> Sum(0.5)
        -> Int
}

Bool => String {
    Bool -> (
        * False { "False" }
        * True { "True" }
    )
}

Float => String {
    Float -> Eq(Float) -> (
        * False { "NaN" }
        * True {
            Float -> Lt(0.0) -> (
                * False { Float -> Magnitude }
                * True { `-{0.0 -> Difference(Float) -> Magnitude}` }
            )
        }
    )
}

Int => String {
    Int -> Lt(0) -> (
        * False { 0 -> Difference(Int) -> Decimals }
        * True { `-{Int -> Decimals}` }
    )
}
