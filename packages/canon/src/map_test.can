MapContainsFindsKey = TestResult

Unit => MapContainsFindsKey {
    Map()
        -> Insert(Key("a") * Value("1"))
        -> Contains("a")
        -> TestResult
}

MapContainsRejectsAbsent = TestResult

Unit => MapContainsRejectsAbsent {
    Map()
        -> Insert(Key("a") * Value("1"))
        -> Contains("z")
        -> Not
        -> TestResult
}

MapInsertRecursesPastMultipleNonMatchingKeys = TestResult

Unit => MapInsertRecursesPastMultipleNonMatchingKeys {
    Map()
        -> Insert(Key("a") * Value("1"))
        -> Insert(Key("b") * Value("2"))
        -> Insert(Key("c") * Value("3"))
        -> Insert(Key("d") * Value("4"))
        -> Keys
        -> Json
        -> Eq("[a,b,c,d]")
        -> TestResult
}

MapKeysSorted = TestResult

Unit => MapKeysSorted {
    Map()
        -> Insert(Key("b") * Value("2"))
        -> Insert(Key("a") * Value("1"))
        -> Keys
        -> Json
        -> Eq("[a,b]")
        -> TestResult
}

MapLengthCountsKeys = TestResult

Unit => MapLengthCountsKeys {
    Map()
        -> Insert(Key("b") * Value("2"))
        -> Insert(Key("a") * Value("1"))
        -> Length
        -> Eq(2)
        -> TestResult
}

MapReinsertOverwrites = TestResult

Unit => MapReinsertOverwrites {
    Map() -> Insert(Key("a") * Value("1")) -> Insert(Key("a") * Value("2")) -> Value("a") -> (
        * None { Fail("key a should be present") }
        * Some<Value> { Value -> Eq("2") -> TestResult }
    )
}

MapRemoveDropsKey = TestResult

Unit => MapRemoveDropsKey {
    Map()
        -> Insert(Key("a") * Value("1"))
        -> Insert(Key("b") * Value("2"))
        -> Remove("a")
        -> Keys
        -> Json
        -> Eq("[b]")
        -> TestResult
}

MapRemoveOnEmptyIsNoOp = TestResult

Unit => MapRemoveOnEmptyIsNoOp {
    Map()
        -> Remove("a")
        -> Length
        -> Eq(0)
        -> TestResult
}

MapRemoveRecursesPastNonMatchingKey = TestResult

Unit => MapRemoveRecursesPastNonMatchingKey {
    Map()
        -> Insert(Key("a") * Value("1"))
        -> Insert(Key("b") * Value("2"))
        -> Remove("b")
        -> Keys
        -> Json
        -> Eq("[a]")
        -> TestResult
}

MapValueAbsent = TestResult

Unit => MapValueAbsent {
    Map() -> Insert(Key("a") * Value("1")) -> Value("z") -> (
        * None { Pass() }
        * Some<Value> { Fail("key z should be absent") }
    )
}

MapValuePresent = TestResult

Unit => MapValuePresent {
    Map() -> Insert(Key("a") * Value("1")) -> Value("a") -> (
        * None { Fail("key a should be present") }
        * Some<Value> { Value -> Eq("1") -> TestResult }
    )
}

MapValuesOrderedByKey = TestResult

Unit => MapValuesOrderedByKey {
    Map()
        -> Insert(Key("b") * Value("2"))
        -> Insert(Key("a") * Value("1"))
        -> Values
        -> Json
        -> Eq("[1,2]")
        -> TestResult
}
