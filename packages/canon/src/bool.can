And = Bool

Not = Bool

Or = Bool

Bool^2 => And {
    Bool.1 -> (
        * False { False() }
        * True { Bool.2 }
    )
}

Bool => Not {
    Bool -> (
        * False { True() }
        * True { False() }
    )
}

Bool^2 => Or {
    Bool.1 -> (
        * False { Bool.2 }
        * True { True() }
    )
}
