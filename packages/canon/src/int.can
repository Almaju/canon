Digits = Int

Ge = Bool

Gt = Bool

IsIntDigit = Bool

Le = Bool

Maximum = Int

Minimum = Int

Ne = Bool

Negated = Int

OtherInt = Int

Int * Pos * String => Result<Digits, MalformedInt> {
    Pos -> Gt(String -> Length) -> (
        * False {
            String -> ByteAt(Pos) -> IsIntDigit -> (
                * False { MalformedInt("invalid integer") -> Err }
                * True {
                    Int
                        -> Product(10)
                        -> Sum(String -> ByteAt(Pos) -> Difference(48))
                        -> Digits(Pos -> Sum(1) * String)
                }
            )
        }
        * True { Int -> Ok }
    )
}

Int * OtherInt => Ge {
    OtherInt -> Lt(Int) -> (
        * False { Int -> Eq(OtherInt) }
        * True { True() }
    )
}

Int * OtherInt => Gt {
    OtherInt -> Lt(Int)
}

String => Result<Int, MalformedInt> {
    String -> Length -> Eq(0) -> (
        * False {
            String -> ByteAt(1) -> Eq(45) -> (
                * False { 0 -> Digits(Pos(1) * String) }
                * True { String -> Negated }
            )
        }
        * True { MalformedInt("empty string is not an Int") -> Err }
    )
}

Int => IsIntDigit {
    Int -> Ge(48) -> (
        * False { False() }
        * True { Int -> Le(57) }
    )
}

Int * OtherInt => Le {
    Int -> Lt(OtherInt) -> (
        * False { Int -> Eq(OtherInt) }
        * True { True() }
    )
}

Int * OtherInt => Maximum {
    Int -> Lt(OtherInt) -> (
        * False { Int }
        * True { OtherInt }
    )
}

Int * OtherInt => Minimum {
    Int -> Lt(OtherInt) -> (
        * False { OtherInt }
        * True { Int }
    )
}

Int * OtherInt => Ne {
    Int -> Eq(OtherInt) -> (
        * False { True() }
        * True { False() }
    )
}

Pos = Int

Result => Result<Negated, MalformedInt> {
    Result -> (
        * Err<MalformedInt> { MalformedInt -> Err }
        * Ok<Int> { 0 -> Difference(Int) -> Ok }
    )
}

String => Result<Negated, MalformedInt> {
    String -> Length -> Eq(1) -> (
        * False { 0 -> Digits(Pos(2) * String) -> Negated }
        * True { MalformedInt("lone minus is not an Int") -> Err }
    )
}
