Digits = Int

Ge = Bool

Gt = Bool

IsIntDigit = Bool

Le = Bool

Maximum = Int

Minimum = Int

Ne = Bool

Negated = Int

Int * Pos * String => Result<Digits, MalformedInt> {
    Pos -> Gt(String -> Length) -> (
        * False {
            String -> ByteAt(Pos) -> IsIntDigit -> (
                * False { MalformedInt("invalid integer") -> Err }
                * True {
                    Int
                        -> Product(10)
                        -> Sum(String -> ByteAt(Pos) -> Difference(48))
                        -> Digits(Pos -> Sum(1) * String)
                }
            )
        }
        * True { Int -> Ok }
    )
}

Int^2 => Ge {
    Int.2 -> Lt(Int.1) -> (
        * False { Int.1 -> Eq(Int.2) }
        * True { True() }
    )
}

Int^2 => Gt {
    Int.2 -> Lt(Int.1)
}

String => Result<Int, MalformedInt> {
    String -> Length -> Eq(0) -> (
        * False {
            String -> ByteAt(1) -> Eq(45) -> (
                * False { 0 -> Digits(Pos(1) * String) }
                * True { String -> Negated }
            )
        }
        * True { MalformedInt("empty string is not an Int") -> Err }
    )
}

Int => IsIntDigit {
    Int -> Ge(48) -> (
        * False { False() }
        * True { Int -> Le(57) }
    )
}

Int^2 => Le {
    Int.1 -> Lt(Int.2) -> (
        * False { Int.1 -> Eq(Int.2) }
        * True { True() }
    )
}

Int^2 => Maximum {
    Int.1 -> Lt(Int.2) -> (
        * False { Int.1 }
        * True { Int.2 }
    )
}

Int^2 => Minimum {
    Int.1 -> Lt(Int.2) -> (
        * False { Int.2 }
        * True { Int.1 }
    )
}

Int^2 => Ne {
    Int.1 -> Eq(Int.2) -> (
        * False { True() }
        * True { False() }
    )
}

Pos = Int

Result => Result<Negated, MalformedInt> {
    Result -> (
        * Err<MalformedInt> { MalformedInt -> Err }
        * Ok<Int> { 0 -> Difference(Int) -> Ok }
    )
}

String => Result<Negated, MalformedInt> {
    String -> Length -> Eq(1) -> (
        * False { 0 -> Digits(Pos(2) * String) -> Negated }
        * True { MalformedInt("lone minus is not an Int") -> Err }
    )
}
