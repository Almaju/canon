SetContainsFindsAdd = TestResult

Unit => SetContainsFindsAdd {
    Set<String>()
        -> Add("x")
        -> Contains("x")
        -> TestResult
}

SetContainsFindsAfterRecursingPastEntries = TestResult

Unit => SetContainsFindsAfterRecursingPastEntries {
    Set<String>()
        -> Add("a")
        -> Add("b")
        -> Add("c")
        -> Contains("c")
        -> TestResult
}

SetContainsRejectsAbsent = TestResult

Unit => SetContainsRejectsAbsent {
    Set<String>()
        -> Add("x")
        -> Contains("y")
        -> Not
        -> TestResult
}

SetContainsRejectsAfterRecursingThroughEntries = TestResult

Unit => SetContainsRejectsAfterRecursingThroughEntries {
    Set<String>()
        -> Add("a")
        -> Add("b")
        -> Add("c")
        -> Contains("d")
        -> Not
        -> TestResult
}

SetDedupesInserts = TestResult

Unit => SetDedupesInserts {
    Set<String>()
        -> Add("b")
        -> Add("a")
        -> Add("b")
        -> Length
        -> Eq(2)
        -> TestResult
}

SetListSorted = TestResult

Unit => SetListSorted {
    Set<String>()
        -> Add("b")
        -> Add("c")
        -> Add("a")
        -> Items
        -> Json
        -> Eq("[a,b,c]")
        -> TestResult
}

SetRemoveAbsentIsNoOp = TestResult

Unit => SetRemoveAbsentIsNoOp {
    Set<String>()
        -> Add("a")
        -> Remove("missing")
        -> Length
        -> Eq(1)
        -> TestResult
}

SetRemoveDropsValue = TestResult

Unit => SetRemoveDropsValue {
    Set<String>()
        -> Add("a")
        -> Add("b")
        -> Remove("a")
        -> Items
        -> Json
        -> Eq("[b]")
        -> TestResult
}

SetRemoveRecursesPastNonMatchingItem = TestResult

Unit => SetRemoveRecursesPastNonMatchingItem {
    Set<String>()
        -> Add("a")
        -> Add("b")
        -> Remove("b")
        -> Items
        -> Json
        -> Eq("[a]")
        -> TestResult
}
