Classed = Html

Class * Html => Classed {
    Html
        -> TagEnd(Offset(1))
        -> Classed(Class * Html)
}

TagEnd * Class * Html => Classed {
    Html(`{Html -> Substring(From(1) * TagEnd -> Difference(1) -> To)} class="{Class -> Escaped}"{
        Html -> Substring(TagEnd -> From * Html -> Length -> To)
    }`)
}
