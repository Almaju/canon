Reported = Unit

String => Reported {
    String -> Url -> (
        * Err<InvalidUrl> { InvalidUrl -> Print }
        * Ok<Url> { Url -> Print }
    )
}

Unit => Program {
    Reported("http://example.com/path")
    Reported("https://example.com")
    Reported("ftp://example.com")
    Reported("http://")
    Reported("http:///path")
    Reported("https://x")
}
