Picked = String

Int => Option<Picked> {
    Int -> Eq(0) -> (
        * False { Some("payload") }
        * True { None() }
    )
}

Unit => Program {
    Picked(1) -> (
        * None => Unit { "none" -> Print }
        * Some<String> => Unit { String -> Print }
    )
    Picked(0) -> (
        * None { "none" -> Print }
        * Some<String> { String -> Print }
    )
}
