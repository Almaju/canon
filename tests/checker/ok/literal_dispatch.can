Classified = String

Path = String

Routed = String

Int => Classified {
    Int -> (
        * 0 { "zero" }
        * 1 { "one" }
        * Int { "many" }
    )
}

Path => Routed {
    Path -> (
        * "/" { "home" }
        * "/notes" { "index" }
        * Path { "not found" }
    )
}

Unit => Program {
    Path("/notes")
        -> Routed
        -> Print
    Classified(2) -> Print
}
