Body = Html

Content = Html

Index = Int

Init = Model

Label = String

Lesson = Html

Model = Page * Query

Msg = String

NavItem = Html

Next = Html

Page = String

Pager = Html

Pane = Html

Play = Html

Prev = Html

Query = String

Rail = Html

RailDot = Html

Slug = String

Tour = Html

Update = Model

Model => Body {
    Model.Query -> Eq("") -> (
        * False { Model.Query -> Results }
        * True { Model.Page -> Content -> String -> Joined(Model.Page -> Pager -> String) -> Html }
    )
}

Page => Content {
    Page -> (
        * "async" { Page -> Tour(Async() -> Html -> Lesson) }
        * "building-and-running" { BuildingAndRunning() -> Html }
        * "calls" { Page -> Tour(Calls() -> Html -> Lesson) }
        * "canon-for-ai" { CanonForAi() -> Html }
        * "capabilities" { Page -> Tour(Capabilities() -> Html -> Lesson) }
        * "codegen-gaps" { CodegenGaps() -> Html }
        * "coming-from" { ComingFrom() -> Html }
        * "compilation" { Compilation() -> Html }
        * "constructors" { Page -> Tour(Constructors() -> Html -> Lesson) }
        * "contributing" { Contributing() -> Html }
        * "deploying" { Deploying() -> Html }
        * "dispatch" { Page -> Tour(Dispatch() -> Html -> Lesson) }
        * "effects-and-async" { EffectsAndAsync() -> Html }
        * "errors" { Page -> Tour(Errors() -> Html -> Lesson) }
        * "expressions" { Expressions() -> Html }
        * "format-strings" { Page -> Tour(FormatStrings() -> Html -> Lesson) }
        * "fullstack" { Fullstack() -> Html }
        * "functions" { Functions() -> Html }
        * "hello" { Page -> Tour(Hello() -> Html -> Lesson) }
        * "how-do-i" { HowDoI() -> Html }
        * "installation" { Installation() -> Html }
        * "lexical-structure" { LexicalStructure() -> Html }
        * "literal-dispatch" { Page -> Tour(LiteralDispatch() -> Html -> Lesson) }
        * "markdown-renderer" { MarkdownRenderer() -> Html }
        * "markdown-web" { MarkdownWeb() -> Html }
        * "modules" { Modules() -> Html }
        * "multifile" { Multifile() -> Html }
        * "newtypes" { Page -> Tour(Newtypes() -> Html -> Lesson) }
        * "notes-api" { NotesApi() -> Html }
        * "numerics" { Numerics() -> Html }
        * "ordering" { Ordering() -> Html }
        * "overview" { Overview() -> Html }
        * "philosophy" { Philosophy() -> Html }
        * "pipes" { Page -> Tour(Pipes() -> Html -> Lesson) }
        * "play" { Play() }
        * "recursion" { Page -> Tour(Recursion() -> Html -> Lesson) }
        * "result-newtypes" { Page -> Tour(ResultNewtypes() -> Html -> Lesson) }
        * "stdlib" { Stdlib() -> Html }
        * "testing" { Page -> Tour(Testing() -> Html -> Lesson) }
        * "types" { Types() -> Html }
        * "types-only" { TypesOnly() -> Html }
        * "validated-constructors" { Page -> Tour(ValidatedConstructors() -> Html -> Lesson) }
        * "wasi" { Wasi() -> Html }
        * "web-target" { WebTarget() -> Html }
        * "worlds" { Page -> Tour(Worlds() -> Html -> Lesson) }
        * String { Introduction() -> Html }
    )
}

Model => Html {
    <div class="app">
        {Styles()}
        <aside class="side">
            <a class="brand" data-msg="Nav:introduction"><b>&#10033;</b> canon</a>
            <form class="search" data-msg-form="Find:"><input type="search" name="q" placeholder="Search the docs…" aria-label="Search the docs" autocomplete="off"></form>
            <div class="sec">Start</div>
            {Model.Page -> NavItem(Slug("introduction") * Label("Why Canon"))}
            {Model.Page -> NavItem(Slug("philosophy") * Label("The Philosophy"))}
            {Model.Page -> NavItem(Slug("coming-from") * Label("Is Canon for You?"))}
            {Model.Page -> NavItem(Slug("canon-for-ai") * Label("Canon for AI"))}
            {Model.Page -> NavItem(Slug("installation") * Label("Installation"))}
            <div class="sec">Tour</div>
            {Model.Page -> NavItem(Slug("hello") * Label("Take the Tour"))}
            {Model.Page -> NavItem(Slug("play") * Label("Playground"))}
            <div class="sec">Examples</div>
            {Model.Page -> NavItem(Slug("multifile") * Label("Multi-File Project"))}
            {Model.Page -> NavItem(Slug("notes-api") * Label("notes-api: JSON Service"))}
            {Model.Page -> NavItem(Slug("markdown-web") * Label("Docs Site in the Browser"))}
            {Model.Page -> NavItem(Slug("fullstack") * Label("Fullstack"))}
            <div class="sec">Reference</div>
            {Model.Page -> NavItem(Slug("how-do-i") * Label("How Do I&#8230;?"))}
            {Model.Page -> NavItem(Slug("stdlib") * Label("Standard Library"))}
            <a class="ext" href="api/index.html">Standard Library API &#8599;</a>
            {Model.Page -> NavItem(Slug("markdown-renderer") * Label("Markdown"))}
            {Model.Page -> NavItem(Slug("wasi") * Label("WASI Interfaces"))}
            {Model.Page -> NavItem(Slug("web-target") * Label("The Web Target"))}
            {Model.Page -> NavItem(Slug("building-and-running") * Label("The canon CLI"))}
            {Model.Page -> NavItem(Slug("deploying") * Label("Deploying"))}
            {Model.Page -> NavItem(Slug("codegen-gaps") * Label("Known Codegen Gaps"))}
            <div class="sec">Specification</div>
            {Model.Page -> NavItem(Slug("overview") * Label("Overview"))}
            {Model.Page -> NavItem(Slug("lexical-structure") * Label("Lexical Structure"))}
            {Model.Page -> NavItem(Slug("types") * Label("Types"))}
            {Model.Page -> NavItem(Slug("numerics") * Label("Numerics"))}
            {Model.Page -> NavItem(Slug("expressions") * Label("Expressions &amp; Dispatch"))}
            {Model.Page -> NavItem(Slug("functions") * Label("Functions"))}
            {Model.Page -> NavItem(Slug("ordering") * Label("Ordering Rules"))}
            {Model.Page -> NavItem(Slug("modules") * Label("Modules &amp; Packages"))}
            {Model.Page -> NavItem(Slug("effects-and-async") * Label("Effects &amp; Async"))}
            {Model.Page -> NavItem(Slug("compilation") * Label("Compilation &amp; ABI"))}
            {Model.Page -> NavItem(Slug("types-only") * Label("Types-Only Canon"))}
            <div class="sec">Project</div>
            {Model.Page -> NavItem(Slug("contributing") * Label("Contributing"))}
        </aside>
        <main class="main"><article class="doc">{Model -> Body}</article></main>
    </div>
}

Unit => Init {
    Page("introduction") -> Model(Query(""))
}

Page * Slug * Label => NavItem {
    Page.String -> Eq(Slug.String) -> (
        * False { Html(`<button data-msg="Nav:{Slug.String}">{Label.String}</button>`) }
        * True {
            Html(`<button class="active" aria-current="page" data-msg="Nav:{Slug.String}">{Label.String}</button>`)
        }
    )
}

Slug * Label => Next {
    Html(`<a class="pager-link pager-next" data-msg="Nav:{Slug.String}"><span class="pager-dir">Next &#8594;</span><span class="pager-title">{Label.String}</span></a>`)
}

