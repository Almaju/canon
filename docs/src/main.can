Body = Html

Content = Html

Index = Int

Init = Model

Label = String

Lesson = Html

Model = Page * Query

Msg = String

NavItem = Html

Next = Html

Owner = String

Page = String

Pager = Html

Pane = Html

Play = Html

Prev = Html

Query = String

Rail = Html

RailDot = Html

Section = String

Side = Html

Slug = String

SpecGroup = Html

SpecLinks = Html

SpecOpen = Html

SpecShut = Html

Tab = Html

Tabs = Html

Tour = Html

Update = Model

Model => Body {
    Model.Query -> Eq("") -> (
        * False { Model.Query -> Results }
        * True { Model.Page -> Content -> String -> Joined(Model.Page -> Pager -> String) -> Html }
    )
}

Page => Content {
    Page -> (
        * "async" { Page -> Tour(Async() -> Html -> Lesson) }
        * "building-and-running" { BuildingAndRunning() -> Html }
        * "builtins" { Builtins() -> Html }
        * "calls" { Page -> Tour(Calls() -> Html -> Lesson) }
        * "capabilities" { Page -> Tour(Capabilities() -> Html -> Lesson) }
        * "codegen-gaps" { CodegenGaps() -> Html }
        * "compilation" { Compilation() -> Html }
        * "constructors" { Page -> Tour(Constructors() -> Html -> Lesson) }
        * "contributing" { Contributing() -> Html }
        * "deploying" { Deploying() -> Html }
        * "dispatch" { Page -> Tour(Dispatch() -> Html -> Lesson) }
        * "effects-and-async" { EffectsAndAsync() -> Html }
        * "errors" { Page -> Tour(Errors() -> Html -> Lesson) }
        * "expressions" { Expressions() -> Html }
        * "format-strings" { Page -> Tour(FormatStrings() -> Html -> Lesson) }
        * "functions" { Functions() -> Html }
        * "hello" { Page -> Tour(Hello() -> Html -> Lesson) }
        * "installation" { Installation() -> Html }
        * "lexical-structure" { LexicalStructure() -> Html }
        * "literal-dispatch" { Page -> Tour(LiteralDispatch() -> Html -> Lesson) }
        * "markdown-renderer" { MarkdownRenderer() -> Html }
        * "modules" { Modules() -> Html }
        * "newtypes" { Page -> Tour(Newtypes() -> Html -> Lesson) }
        * "numerics" { Numerics() -> Html }
        * "ordering" { Ordering() -> Html }
        * "overview" { Overview() -> Html }
        * "packages" { Packages() -> Html }
        * "philosophy" { Philosophy() -> Html }
        * "pipes" { Page -> Tour(Pipes() -> Html -> Lesson) }
        * "play" { Play() }
        * "recursion" { Page -> Tour(Recursion() -> Html -> Lesson) }
        * "result-newtypes" { Page -> Tour(ResultNewtypes() -> Html -> Lesson) }
        * "stdlib" { Stdlib() -> Html }
        * "testing" { Page -> Tour(Testing() -> Html -> Lesson) }
        * "types" { Types() -> Html }
        * "types-only" { TypesOnly() -> Html }
        * "validated-constructors" { Page -> Tour(ValidatedConstructors() -> Html -> Lesson) }
        * "wasi" { Wasi() -> Html }
        * "web-target" { WebTarget() -> Html }
        * "worlds" { Page -> Tour(Worlds() -> Html -> Lesson) }
        * String { Introduction() -> Html }
    )
}

Model => Html {
    <div class="app">
        {Styles()}
        <header class="top">
            <a class="brand" data-msg="Nav:introduction"><b>&#10033;</b> canon</a>
            {Model.Page -> Tabs}
            <form class="search" data-msg-form="Find:"><input type="search" name="q" placeholder="Search…" aria-label="Search the docs" autocomplete="off"></form>
        </header>
        <div class="shell">
            {Model -> Side}
            <main class="main"><article class="doc">{Model -> Body}</article></main>
        </div>
    </div>
}

Unit => Init {
    Page("introduction") -> Model(Query(""))
}

Page * Slug * Label => NavItem {
    Page.String -> Eq(Slug.String) -> (
        * False { Html(`<button data-msg="Nav:{Slug.String}">{Label.String}</button>`) }
        * True {
            Html(`<button class="active" aria-current="page" data-msg="Nav:{Slug.String}">{Label.String}</button>`)
        }
    )
}

Slug * Label => Next {
    Html(`<a class="pager-link pager-next" data-msg="Nav:{Slug.String}"><span class="pager-dir">Next &#8594;</span><span class="pager-title">{Label.String}</span></a>`)
}

Page => Pager {
    Page -> (
        * "async" {
            Html(`<nav class="pager">{
                Slug("capabilities")
                    -> Prev(Label("Effects Are Values"))
                    -> String
            }{Slug("testing") -> Next(Label("Tests Are Types")) -> String}</nav>`)
        }
        * "calls" {
            Html(`<nav class="pager">{
                Slug("constructors")
                    -> Prev(Label("Conversion Is Construction"))
                    -> String
            }{Slug("dispatch") -> Next(Label("Branching Is Dispatch")) -> String}</nav>`)
        }
        * "capabilities" {
            Html(`<nav class="pager">{
                Slug("validated-constructors")
                    -> Prev(Label("Constructors That Check"))
                    -> String
            }{Slug("async") -> Next(Label("Async Without a Keyword")) -> String}</nav>`)
        }
        * "constructors" {
            Html(`<nav class="pager">{
                Slug("format-strings")
                    -> Prev(Label("Strings With Holes"))
                    -> String
            }{Slug("calls") -> Next(Label("Calls With More Than One Input")) -> String}</nav>`)
        }
        * "dispatch" {
            Html(`<nav class="pager">{
                Slug("calls")
                    -> Prev(Label("Calls With More Than One Input"))
                    -> String
            }{Slug("literal-dispatch") -> Next(Label("Dispatch on Literals")) -> String}</nav>`)
        }
        * "errors" {
            Html(`<nav class="pager">{
                Slug("result-newtypes")
                    -> Prev(Label("Naming What Happened"))
                    -> String
            }{Slug("validated-constructors") -> Next(Label("Constructors That Check")) -> String}</nav>`)
        }
        * "format-strings" {
            Html(`<nav class="pager">{
                Slug("newtypes")
                    -> Prev(Label("Types Are the Vocabulary"))
                    -> String
            }{Slug("constructors") -> Next(Label("Conversion Is Construction")) -> String}</nav>`)
        }
        * "hello" {
            Html(`<nav class="pager">{Slug("pipes") -> Next(Label("Three Symbols")) -> String}</nav>`)
        }
        * "literal-dispatch" {
            Html(`<nav class="pager">{
                Slug("dispatch")
                    -> Prev(Label("Branching Is Dispatch"))
                    -> String
            }{Slug("recursion") -> Next(Label("Loops Without Loops")) -> String}</nav>`)
        }
        * "newtypes" {
            Html(`<nav class="pager">{Slug("pipes") -> Prev(Label("Three Symbols")) -> String}{
                Slug("format-strings")
                    -> Next(Label("Strings With Holes"))
                    -> String
            }</nav>`)
        }
        * "pipes" {
            Html(`<nav class="pager">{Slug("hello") -> Prev(Label("Hello, Canon")) -> String}{
                Slug("newtypes")
                    -> Next(Label("Types Are the Vocabulary"))
                    -> String
            }</nav>`)
        }
        * "recursion" {
            Html(`<nav class="pager">{
                Slug("literal-dispatch")
                    -> Prev(Label("Dispatch on Literals"))
                    -> String
            }{Slug("result-newtypes") -> Next(Label("Naming What Happened")) -> String}</nav>`)
        }
        * "result-newtypes" {
            Html(`<nav class="pager">{
                Slug("recursion")
                    -> Prev(Label("Loops Without Loops"))
                    -> String
            }{Slug("errors") -> Next(Label("Failure Is a Value")) -> String}</nav>`)
        }
        * "testing" {
            Html(`<nav class="pager">{
                Slug("async")
                    -> Prev(Label("Async Without a Keyword"))
                    -> String
            }{Slug("worlds") -> Next(Label("One Arrow, Three Worlds")) -> String}</nav>`)
        }
        * "validated-constructors" {
            Html(`<nav class="pager">{Slug("errors") -> Prev(Label("Failure Is a Value")) -> String}{
                Slug("capabilities")
                    -> Next(Label("Effects Are Values"))
                    -> String
            }</nav>`)
        }
        * "worlds" {
            Html(`<nav class="pager">{Slug("testing") -> Prev(Label("Tests Are Types")) -> String}</nav>`)
        }
        * String { Html("") }
    )
}

Unit => Pane {
    <div class="pg">
        <div class="pg-bar">
            <button class="pg-run"><span class="canon-run-glyph">&#9654;</span> run</button>
            <span class="pg-hint">&#8984;/Ctrl + Enter</span>
            <button class="pg-share">share</button>
            <button class="pg-reset">reset</button>
            <span class="pg-status"></span>
        </div>
        <div class="pg-edit">
            <pre class="pg-hl" aria-hidden="true"><code></code></pre>
            <textarea class="pg-editor" spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="Canon source"></textarea>
        </div>
        <div class="pg-panel">
            <div class="pg-panel-bar"><span class="dot"></span><span>output</span></div>
            <pre class="pg-out"><code></code></pre>
        </div>
    </div>
}

Unit => Play {
    <div class="pg-page">
        <h1>Playground</h1>
        <p>The Canon compiler is a WebAssembly module running in this tab. Your program is compiled to a component and executed here — nothing is sent to a server.</p>
        {Pane()}
    </div>
}

Slug * Label => Prev {
    Html(`<a class="pager-link pager-prev" data-msg="Nav:{Slug.String}"><span class="pager-dir">&#8592; Previous</span><span class="pager-title">{Label.String}</span></a>`)
}

Page => Rail {
    <nav class="rail" aria-label="Tour steps">
        {Page -> RailDot(Slug("hello") * Index(1))}
        {Page -> RailDot(Slug("pipes") * Index(2))}
        {Page -> RailDot(Slug("newtypes") * Index(3))}
        {Page -> RailDot(Slug("format-strings") * Index(4))}
        {Page -> RailDot(Slug("constructors") * Index(5))}
        {Page -> RailDot(Slug("calls") * Index(6))}
        {Page -> RailDot(Slug("dispatch") * Index(7))}
        {Page -> RailDot(Slug("literal-dispatch") * Index(8))}
        {Page -> RailDot(Slug("recursion") * Index(9))}
        {Page -> RailDot(Slug("result-newtypes") * Index(10))}
        {Page -> RailDot(Slug("errors") * Index(11))}
        {Page -> RailDot(Slug("validated-constructors") * Index(12))}
        {Page -> RailDot(Slug("capabilities") * Index(13))}
        {Page -> RailDot(Slug("async") * Index(14))}
        {Page -> RailDot(Slug("testing") * Index(15))}
        {Page -> RailDot(Slug("worlds") * Index(16))}
    </nav>
}

Page * Slug * Index => RailDot {
    Page.String -> Eq(Slug.String) -> (
        * False {
            Html(`<button class="rail-dot" data-msg="Nav:{Slug.String}">{Index -> String}</button>`)
        }
        * True {
            Html(`<button class="rail-dot active" aria-current="step" data-msg="Nav:{Slug.String}">{
                Index -> String
            }</button>`)
        }
    )
}

Page => Section {
    Page -> (
        * "async" { Section("tour") }
        * "calls" { Section("tour") }
        * "capabilities" { Section("tour") }
        * "constructors" { Section("tour") }
        * "dispatch" { Section("tour") }
        * "errors" { Section("tour") }
        * "format-strings" { Section("tour") }
        * "hello" { Section("tour") }
        * "literal-dispatch" { Section("tour") }
        * "newtypes" { Section("tour") }
        * "pipes" { Section("tour") }
        * "play" { Section("play") }
        * "recursion" { Section("tour") }
        * "result-newtypes" { Section("tour") }
        * "testing" { Section("tour") }
        * "validated-constructors" { Section("tour") }
        * "worlds" { Section("tour") }
        * String { Section("docs") }
    )
}

Model => Side {
    Model.Page -> Section -> (
        * "docs" {
            <aside class="side">
                {Model.Page -> NavItem(Slug("introduction") * Label("Why Canon"))}
                {Model.Page -> NavItem(Slug("philosophy") * Label("The Philosophy"))}
                {Model.Page -> NavItem(Slug("installation") * Label("Installation"))}
                {Model.Page -> NavItem(Slug("building-and-running") * Label("The canon CLI"))}
                {Model.Page -> NavItem(Slug("stdlib") * Label("Standard Library"))}
                {Model.Page -> NavItem(Slug("packages") * Label("Packages"))}
                {Model.Page -> NavItem(Slug("builtins") * Label("Builtins"))}
                {Model.Page -> NavItem(Slug("web-target") * Label("The Web Target"))}
                {Model.Page -> NavItem(Slug("wasi") * Label("WASI Interfaces"))}
                {Model.Page -> NavItem(Slug("markdown-renderer") * Label("Markdown"))}
                {Model.Page -> NavItem(Slug("deploying") * Label("Deploying"))}
                {Model.Page -> NavItem(Slug("codegen-gaps") * Label("Known Codegen Gaps"))}
                {Model.Page -> NavItem(Slug("contributing") * Label("Contributing"))}
                {Model.Page -> SpecGroup}
            </aside>
        }
        * String { Html("") }
    )
}

Page => SpecGroup {
    Page -> (
        * "compilation" { Page -> SpecOpen }
        * "effects-and-async" { Page -> SpecOpen }
        * "expressions" { Page -> SpecOpen }
        * "functions" { Page -> SpecOpen }
        * "lexical-structure" { Page -> SpecOpen }
        * "modules" { Page -> SpecOpen }
        * "numerics" { Page -> SpecOpen }
        * "ordering" { Page -> SpecOpen }
        * "overview" { Page -> SpecOpen }
        * "types" { Page -> SpecOpen }
        * "types-only" { Page -> SpecOpen }
        * String { Page -> SpecShut }
    )
}

Page => SpecLinks {
    <div class="grp-body">
        {Page -> NavItem(Slug("overview") * Label("Overview"))}
        {Page -> NavItem(Slug("lexical-structure") * Label("Lexical Structure"))}
        {Page -> NavItem(Slug("types") * Label("Types"))}
        {Page -> NavItem(Slug("numerics") * Label("Numerics"))}
        {Page -> NavItem(Slug("expressions") * Label("Expressions &amp; Dispatch"))}
        {Page -> NavItem(Slug("functions") * Label("Functions"))}
        {Page -> NavItem(Slug("ordering") * Label("Ordering Rules"))}
        {Page -> NavItem(Slug("modules") * Label("Modules &amp; Packages"))}
        {Page -> NavItem(Slug("effects-and-async") * Label("Effects &amp; Async"))}
        {Page -> NavItem(Slug("compilation") * Label("Compilation &amp; ABI"))}
        {Page -> NavItem(Slug("types-only") * Label("Types-Only Canon"))}
    </div>
}

Page => SpecOpen {
    <details class="grp" open="open"><summary>Specification</summary>{Page -> SpecLinks}</details>
}

Page => SpecShut {
    <details class="grp"><summary>Specification</summary>{Page -> SpecLinks}</details>
}

Section * Owner * Slug * Label => Tab {
    Section.String -> Eq(Owner.String) -> (
        * False { Html(`<button class="tab" data-msg="Nav:{Slug.String}">{Label.String}</button>`) }
        * True {
            Html(`<button class="tab active" aria-current="page" data-msg="Nav:{Slug.String}">{Label.String}</button>`)
        }
    )
}

Page => Tabs {
    <nav class="tabs">
        {Page -> Section -> Tab(Owner("docs") * Slug("introduction") * Label("Docs"))}
        {Page -> Section -> Tab(Owner("tour") * Slug("hello") * Label("Tour"))}
        {Page -> Section -> Tab(Owner("play") * Slug("play") * Label("Playground"))}
        <a class="tab" href="api/index.html">API &#8599;</a>
    </nav>
}

Page * Lesson => Tour {
    <div class="tour">
        <div class="tour-doc">{Page -> Rail}{Lesson}</div>
        <div class="tour-pane">{Pane()}</div>
    </div>
}

Model * Msg => Update {
    Msg -> Substring(From(1) * To(4)) -> (
        * "Find" { Model.Page -> Model(Msg -> Substring(From(6) * Msg -> Length -> To) -> Query) }
        * "Nav:" { Msg -> Substring(From(5) * Msg -> Length -> To) -> Page -> Model(Query("")) }
        * String { Model }
    )
}
