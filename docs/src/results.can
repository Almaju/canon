Hit = Html

Hits = Html

Holds = Bool

LineHolds = Bool

Lowered = Int

Needle = String

PrefixMatch = Bool

Results = Html

Start = Int

Step = Int

Stop = Int

Text = String

Query * Slug * Label * Text => Hit {
    Text.String -> Holds(Query.String -> Needle * Start(1)) -> (
        * False { Html("") }
        * True { <button class="result" data-msg="Nav:{Slug -> String}">{Label -> String}</button> }
    )
}

