String * Needle * Start => Holds {
    Start -> Gt(String -> Length) -> (
        * False {
            String -> LineHolds(Needle * Start * String -> Stop(Start)) -> (
                * False { String -> Holds(Needle * String -> Stop(Start) -> Sum(1) -> Start) }
                * True { True() }
            )
        }
        * True { False() }
    )
}

String * Needle * Start * Stop => LineHolds {
    Start -> Sum(Needle -> Length -> Difference(1)) -> Gt(Stop -> Difference(1)) -> (
        * False {
            String -> PrefixMatch(Needle * Start * Step(1)) -> (
                * False { String -> LineHolds(Needle * Start -> Sum(1) -> Start * Stop) }
                * True { True() }
            )
        }
        * True { False() }
    )
}

Int => Lowered {
    Int -> Ge(65) -> (
        * False { Int }
        * True {
            Int -> Le(90) -> (
                * False { Int }
                * True { Int -> Sum(32) }
            )
        }
    )
}

String * Needle * Start * Step => PrefixMatch {
    Step -> Gt(Needle -> Length) -> (
        * False {
            String
                -> ByteAt(Start -> Sum(Step) -> Difference(1))
                -> Lowered
                -> Eq(Needle -> ByteAt(Step) -> Lowered) -> (
                * False { False() }
                * True { String -> PrefixMatch(Needle * Start * Step -> Sum(1) -> Step) }
            )
        }
        * True { True() }
    )
}

Query => Results {
    Query -> Hits -> String -> Length -> Eq(0) -> (
        * False {
            <div class="results"><div class="results-head">Matches for “{Query -> String}”</div>{
                Query -> Hits
            }</div>
        }
        * True {
            <div class="results"><div class="results-head">No matches for “{Query -> String}”</div></div>
        }
    )
}

String * Start => Stop {
    Start -> Gt(String -> Length) -> (
        * False {
            String -> ByteAt(Start) -> Eq(10) -> (
                * False { String -> Stop(Start -> Sum(1) -> Start) }
                * True { Start }
            )
        }
        * True { Start }
    )
}
